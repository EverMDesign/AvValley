---
---

<header class="fixed top-0 left-0 w-full bg-brand-bg/95 backdrop-blur-md border-b border-brand-border z-50 transition-all duration-300" id="main-header">
  <div class="max-w-container mx-auto px-6 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center group focus:outline-none" aria-label="AvValley Home">
      <img src="/images/AVValley-Logo.png" alt="AvValley Logo" class="h-12 w-auto group-hover:opacity-90 transition-opacity" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-5 flex-1 justify-center">
      <a href="/mobile-stage-rental" class="text-sm font-medium text-brand-muted hover:text-white transition-colors whitespace-nowrap">Stage Rent</a>

      <!-- Projectors Dropdown -->
      <div class="relative group">
        <button class="text-sm font-medium text-brand-muted hover:text-white transition-colors whitespace-nowrap flex items-center gap-1">
          Projectors
          <i class="ph-bold ph-caret-down text-sm group-hover:text-white transition-colors"></i>
        </button>
        <div class="absolute left-0 mt-2 w-48 bg-brand-card border border-brand-border rounded-lg shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
          <a href="/purchase-projector" class="block px-4 py-3 text-sm font-medium text-brand-muted hover:text-white hover:bg-brand-bg/50 transition-colors rounded-t-lg">Purchase Projector</a>
          <a href="/rent-projector" class="block px-4 py-3 text-sm font-medium text-brand-muted hover:text-white hover:bg-brand-bg/50 transition-colors border-t border-brand-border rounded-b-lg">Rent a Projector</a>
        </div>
      </div>

      <a href="/projection-mapping" class="text-sm font-medium text-brand-muted hover:text-white transition-colors whitespace-nowrap">Projection Mapping</a>
      <a href="/silent-disco-rentals" class="text-sm font-medium text-brand-muted hover:text-white transition-colors whitespace-nowrap">Silent Disco Party</a>
      <a href="/outdoor-movie-rentals" class="text-sm font-medium text-brand-muted hover:text-white transition-colors whitespace-nowrap">Air Screen Movies</a>
    </nav>

    <!-- CTA Button -->
    <div class="hidden lg:flex items-center gap-4">
      <a href="tel:4805674215" class="bg-brand-blue hover:bg-brand-hover text-white px-6 py-2.5 rounded font-heading font-bold text-xs uppercase tracking-wider transition-colors shadow-[0_0_15px_rgba(22,154,220,0.3)] hover:shadow-[0_0_20px_rgba(26,175,232,0.5)]">
        Call 480-567-4215
      </a>
    </div>

    <!-- Mobile Menu Toggle -->
    <button id="mobile-menu-btn" class="lg:hidden text-white p-2 focus:outline-none" aria-label="Toggle Menu">
      <i class="ph ph-list text-3xl"></i>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="fixed inset-0 bg-brand-bg border-t border-brand-border z-40 hidden flex-col pt-24 px-6 pb-6 lg:hidden h-screen overflow-y-auto">
    <!-- Close Button -->
    <button id="mobile-menu-close" class="absolute top-6 right-6 text-white p-2 focus:outline-none" aria-label="Close Menu">
      <i class="ph ph-x text-3xl"></i>
    </button>

    <nav class="flex flex-col gap-6 text-center">
      <a href="/mobile-stage-rental" class="text-2xl font-heading font-semibold text-white mobile-link">Stage Rent</a>

      <!-- Projectors Mobile Dropdown -->
      <div class="border-b border-brand-border pb-6">
        <button id="projectors-mobile-btn" class="text-2xl font-heading font-semibold text-white flex items-center justify-center gap-2 w-full">
          Projectors
          <i id="projectors-mobile-icon" class="ph-bold ph-caret-down text-xl transition-transform"></i>
        </button>
        <div id="projectors-mobile-menu" class="max-h-0 overflow-hidden transition-all duration-300">
          <div class="flex flex-col gap-4 pt-4 mt-4 border-t border-brand-border">
            <a href="/purchase-projector" class="text-xl font-heading font-semibold text-brand-muted hover:text-white transition-colors mobile-link">Purchase Projector</a>
            <a href="/rent-projector" class="text-xl font-heading font-semibold text-brand-muted hover:text-white transition-colors mobile-link">Rent a Projector</a>
          </div>
        </div>
      </div>

      <a href="/projection-mapping" class="text-2xl font-heading font-semibold text-white mobile-link">Projection Mapping</a>
      <a href="/silent-disco-rentals" class="text-2xl font-heading font-semibold text-white mobile-link">Silent Disco Party</a>
      <a href="/outdoor-movie-rentals" class="text-2xl font-heading font-semibold text-white mobile-link">Air Screen Movies</a>
      <div class="mt-8 pt-8 border-t border-brand-border flex flex-col gap-4">
        <a href="tel:4805674215" class="bg-transparent border border-brand-blue text-brand-blue py-4 rounded font-heading font-bold uppercase tracking-wider">Call 480-567-4215</a>
        <a href="/#quote" class="bg-brand-blue text-white py-4 rounded font-heading font-bold uppercase tracking-wider mobile-link">Request a Quote</a>
      </div>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const header = document.getElementById('main-header');

    function toggleMenu() {
      mobileMenu.classList.toggle('hidden');
      mobileMenu.classList.toggle('flex');
      if(!mobileMenu.classList.contains('hidden')) {
        menuBtn.innerHTML = '<i class="ph ph-x text-3xl"></i>';
        document.body.style.overflow = 'hidden';
      } else {
        menuBtn.innerHTML = '<i class="ph ph-list text-3xl"></i>';
        document.body.style.overflow = '';
      }
    }

    menuBtn.addEventListener('click', toggleMenu);

    const closeBtn = document.getElementById('mobile-menu-close');
    if (closeBtn) {
      closeBtn.addEventListener('click', toggleMenu);
    }
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if(!mobileMenu.classList.contains('hidden')){
          toggleMenu();
        }
      });
    });

    // Mobile Projectors Dropdown
    const projectorsMobileBtn = document.getElementById('projectors-mobile-btn');
    const projectorsMobileMenu = document.getElementById('projectors-mobile-menu');
    const projectorsMobileIcon = document.getElementById('projectors-mobile-icon');

    if (projectorsMobileBtn) {
      projectorsMobileBtn.addEventListener('click', () => {
        const isOpen = projectorsMobileMenu.style.maxHeight;
        if (!isOpen || isOpen === '0px') {
          projectorsMobileMenu.style.maxHeight = projectorsMobileMenu.scrollHeight + "px";
          projectorsMobileIcon.classList.add('rotate-180');
        } else {
          projectorsMobileMenu.style.maxHeight = '0px';
          projectorsMobileIcon.classList.remove('rotate-180');
        }
      });
    }

    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        header.classList.add('shadow-lg', 'bg-brand-bg/95');
      } else {
        header.classList.remove('shadow-lg');
      }
    });
  });
</script>
