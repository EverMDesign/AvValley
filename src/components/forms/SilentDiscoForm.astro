---
interface Props {
  id?: string;
}

const { id = 'silent-disco-form' } = Astro.props;
---

<div class="w-full">
  <!-- Form Header -->
  <div class="mb-8">
    <h3 class="font-heading font-bold text-2xl text-white mb-2">Reserve Silent Disco Equipment</h3>
    <p class="text-brand-muted text-sm">Tell us about your event and headphone needs.</p>
  </div>

  <!-- Success Message -->
  <div id={`${id}-success`} class="hidden bg-brand-success/10 border border-brand-success text-brand-success p-4 rounded-lg mb-6">
    <p class="font-bold text-sm">Thank you! We'll send silent disco equipment details shortly.</p>
  </div>

  <!-- Form -->
  <form id={id} class="space-y-6">
    <!-- Contact Information -->
    <div class="space-y-4">
      <h4 class="font-heading font-bold text-sm text-brand-blue uppercase tracking-wide border-b border-brand-border pb-2">Contact Information</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Full Name *</label>
          <input type="text" name="name" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Organization</label>
          <input type="text" name="organization" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Email *</label>
          <input type="email" name="email" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Phone *</label>
          <input type="tel" name="phone" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
      </div>
    </div>

    <!-- Event Details -->
    <div class="space-y-4">
      <h4 class="font-heading font-bold text-sm text-brand-blue uppercase tracking-wide border-b border-brand-border pb-2">Event Details</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Event Date</label>
          <input type="date" name="event_date" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors [color-scheme:dark]" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Location (City/Zip) *</label>
          <input type="text" name="location" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Event Type</label>
          <input type="text" name="event_type" placeholder="e.g. Wedding, Party, Corporate Event" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Expected Number of Guests</label>
          <input type="number" name="guest_count" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
      </div>
    </div>

    <!-- Equipment Specifications -->
    <div class="space-y-4">
      <h4 class="font-heading font-bold text-sm text-brand-blue uppercase tracking-wide border-b border-brand-border pb-2">Equipment Specifications</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Package Type *</label>
          <select name="package_type" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors appearance-none">
            <option value="">Select a package...</option>
            <option value="Headphone-Only Rental">Headphone-Only Rental</option>
            <option value="Standard Silent Disco Package">Standard Silent Disco Package</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Number of Headphones Needed *</label>
          <input type="number" name="headphone_count" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" placeholder="e.g. 50, 100" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Number of DJ Channels</label>
          <select name="dj_channels" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors appearance-none">
            <option value="">Select...</option>
            <option value="1">1 DJ (1 Channel)</option>
            <option value="2">2 DJs (2 Channels)</option>
            <option value="3">3 DJs (3 Channels)</option>
            <option value="4">4 DJs (4 Channels)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Event Duration</label>
          <select name="duration" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors appearance-none">
            <option value="">Select...</option>
            <option value="4 hours">4 Hours</option>
            <option value="6 hours">6 Hours</option>
            <option value="8 hours">8 Hours</option>
            <option value="Full Night">Full Night (12+ Hours)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Delivery/Setup</label>
          <select name="delivery" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors appearance-none">
            <option value="">Select...</option>
            <option value="Customer Pickup">Customer Pickup</option>
            <option value="AvValley Delivery">AvValley Delivery & Setup</option>
            <option value="Full Support">Full Support (Setup & Operator)</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Additional Features -->
    <div class="space-y-4">
      <h4 class="font-heading font-bold text-sm text-brand-blue uppercase tracking-wide border-b border-brand-border pb-2">Add-On Options</h4>
      <div class="space-y-3">
        <label class="flex items-center gap-3 cursor-pointer group">
          <input type="checkbox" name="backup_headphones" class="w-4 h-4 bg-brand-bg border-brand-border rounded focus:ring-brand-blue accent-brand-blue" />
          <span class="text-sm text-brand-muted group-hover:text-white transition-colors">Include backup/replacement headphones</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer group">
          <input type="checkbox" name="outdoor_equipment" class="w-4 h-4 bg-brand-bg border-brand-border rounded focus:ring-brand-blue accent-brand-blue" />
          <span class="text-sm text-brand-muted group-hover:text-white transition-colors">Outdoor/weatherproof equipment</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer group">
          <input type="checkbox" name="dj_operator" class="w-4 h-4 bg-brand-bg border-brand-border rounded focus:ring-brand-blue accent-brand-blue" />
          <span class="text-sm text-brand-muted group-hover:text-white transition-colors">Professional DJ operator included</span>
        </label>
      </div>
    </div>

    <!-- Additional Details -->
    <div>
      <label class="block text-sm font-medium text-brand-muted mb-2">Additional Details</label>
      <textarea name="message" rows="4" placeholder="Any special requests, music preferences, or technical requirements..." class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors resize-none"></textarea>
    </div>

    <!-- Consent -->
    <div class="flex items-start gap-3">
      <input id="consent-check" type="checkbox" name="consent" required class="w-4 h-4 bg-brand-bg border-brand-border rounded focus:ring-brand-blue accent-brand-blue mt-1 cursor-pointer" />
      <label for="consent-check" class="text-xs text-brand-muted leading-relaxed cursor-pointer hover:text-white transition-colors">
        I consent to AvValley contacting me regarding this silent disco inquiry. Your information is kept secure.
      </label>
    </div>

    <button type="submit" class="w-full bg-brand-blue hover:bg-brand-hover text-white px-8 py-4 rounded font-heading font-bold uppercase tracking-wider transition-colors shadow-[0_0_15px_rgba(22,154,220,0.3)]">
      RESERVE EQUIPMENT
    </button>
  </form>
</div>

<script define:vars={{ id }}>
  const form = document.getElementById(id);
  const successDiv = document.getElementById(`${id}-success`);

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      console.log('Silent Disco Form Submitted:', new FormData(form));
      form.style.display = 'none';
      successDiv.classList.remove('hidden');
      setTimeout(() => {
        form.reset();
        form.style.display = '';
        successDiv.classList.add('hidden');
      }, 3000);
    });
  }
</script>
