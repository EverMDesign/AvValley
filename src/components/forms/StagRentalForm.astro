---
interface Props {
  id?: string;
}

const { id = 'stage-rental-form' } = Astro.props;
---

<div class="w-full">
  <!-- Form Header -->
  <div class="mb-8">
    <h3 class="font-heading font-bold text-2xl text-white mb-2">Request a Stage Rental Quote</h3>
    <p class="text-brand-muted text-sm">Tell us about your event and stage requirements.</p>
  </div>

  <!-- Success Message -->
  <div id={`${id}-success`} class="hidden bg-brand-success/10 border border-brand-success text-brand-success p-4 rounded-lg mb-6">
    <p class="font-bold text-sm">Thank you! We'll contact you soon with stage rental details.</p>
  </div>

  <!-- Form -->
  <form id={id} class="space-y-6">
    <!-- Contact Information -->
    <div class="space-y-4">
      <h4 class="font-heading font-bold text-sm text-brand-blue uppercase tracking-wide border-b border-brand-border pb-2">Contact Information</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Full Name *</label>
          <input type="text" name="name" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Organization</label>
          <input type="text" name="organization" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Email *</label>
          <input type="email" name="email" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Phone *</label>
          <input type="tel" name="phone" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
      </div>
    </div>

    <!-- Event Details -->
    <div class="space-y-4">
      <h4 class="font-heading font-bold text-sm text-brand-blue uppercase tracking-wide border-b border-brand-border pb-2">Event Details</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Event Date</label>
          <input type="date" name="event_date" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors [color-scheme:dark]" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Location (City/Zip) *</label>
          <input type="text" name="location" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Event Type</label>
          <input type="text" name="event_type" placeholder="e.g. Concert, Festival, Corporate Event" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Expected Audience Size</label>
          <input type="number" name="audience_size" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
      </div>
    </div>

    <!-- Stage Requirements -->
    <div class="space-y-4">
      <h4 class="font-heading font-bold text-sm text-brand-blue uppercase tracking-wide border-b border-brand-border pb-2">Stage Requirements</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Sound System Needed</label>
          <select name="sound_system" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors appearance-none">
            <option value="">Select...</option>
            <option value="Basic Sound">Basic Sound System</option>
            <option value="Professional Audio">Professional Audio</option>
            <option value="Not Needed">Not Needed</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Lighting Needed</label>
          <select name="lighting" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors appearance-none">
            <option value="">Select...</option>
            <option value="Basic Lighting">Basic Lighting</option>
            <option value="Advanced Lighting">Advanced Lighting</option>
            <option value="Not Needed">Not Needed</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Delivery/Setup Needed</label>
          <select name="delivery" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors appearance-none">
            <option value="">Select...</option>
            <option value="Customer Pickup">Customer Pickup</option>
            <option value="AvValley Delivery">AvValley Delivery & Setup</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Additional Details -->
    <div>
      <label class="block text-sm font-medium text-brand-muted mb-2">Additional Details</label>
      <textarea name="message" rows="4" placeholder="Any special requirements, terrain details, or notes..." class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors resize-none"></textarea>
    </div>

    <!-- Consent -->
    <div class="flex items-start gap-3">
      <input type="checkbox" name="consent" required class="w-4 h-4 bg-brand-bg border-brand-border rounded focus:ring-brand-blue accent-brand-blue mt-1" />
      <label class="text-xs text-brand-muted leading-relaxed">
        I consent to AvValley contacting me regarding this quote request. Your information is kept secure.
      </label>
    </div>

    <button type="submit" class="w-full bg-brand-blue hover:bg-brand-hover text-white px-8 py-4 rounded font-heading font-bold uppercase tracking-wider transition-colors shadow-[0_0_15px_rgba(22,154,220,0.3)]">
      REQUEST STAGE QUOTE
    </button>
  </form>
</div>

<script define:vars={{ id }}>
  const form = document.getElementById(id);
  const successDiv = document.getElementById(`${id}-success`);
  const submitBtn = form?.querySelector('button[type="submit"]');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Disable button during submission
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'SUBMITTING...';
      }

      try {
        // Collect form data
        const formDataObj = new FormData(form);
        const data = Object.fromEntries(formDataObj.entries());
        data.service = 'stage-rental';

        // Submit to API endpoint
        const response = await fetch('/api/submit-form', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (result.success) {
          // Show success message
          form.style.display = 'none';
          successDiv.classList.remove('hidden');

          // Reset form after delay
          setTimeout(() => {
            form.reset();
            form.style.display = '';
            successDiv.classList.add('hidden');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'REQUEST STAGE QUOTE';
            }
          }, 3000);
        } else {
          alert(`Error: ${result.error || 'Failed to submit form'}`);
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'REQUEST STAGE QUOTE';
          }
        }
      } catch (error) {
        console.error('Form submission error:', error);
        alert('An error occurred while submitting the form. Please try again.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'REQUEST STAGE QUOTE';
        }
      }
    });
  }
</script>
