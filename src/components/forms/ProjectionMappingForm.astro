---
interface Props {
  id?: string;
}

const { id = 'projection-mapping-form' } = Astro.props;
---

<div class="w-full">
  <!-- Form Header -->
  <div class="mb-8">
    <h3 class="font-heading font-bold text-2xl text-white mb-2">Tell Us About Your Projection Mapping Project</h3>
    <p class="text-brand-muted text-sm">Provide the project details, location, surface information, and creative goals so AvValley can evaluate feasibility and prepare the appropriate production plan.</p>
  </div>

  <!-- Success Message -->
  <div id={`${id}-success`} class="hidden bg-brand-success/10 border border-brand-success text-brand-success p-4 rounded-lg mb-6">
    <p class="font-bold text-sm">Thank you! We'll contact you soon with a mapping consultation plan.</p>
  </div>

  <!-- Form -->
  <form id={id} class="space-y-6">
    <!-- Contact Information -->
    <div class="space-y-4">
      <h4 class="font-heading font-bold text-sm text-brand-blue uppercase tracking-wide border-b border-brand-border pb-2">Contact Information</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Full Name *</label>
          <input type="text" name="name" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Organization or Company</label>
          <input type="text" name="organization" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Email Address *</label>
          <input type="email" name="email" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Phone Number *</label>
          <input type="tel" name="phone" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
      </div>
    </div>

    <!-- Event Details -->
    <div class="space-y-4">
      <h4 class="font-heading font-bold text-sm text-brand-blue uppercase tracking-wide border-b border-brand-border pb-2">Event Details</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Event Date</label>
          <input type="date" name="event_date" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors [color-scheme:dark]" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Event Location (City/Zip) *</label>
          <input type="text" name="location" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Indoor or Outdoor *</label>
          <select name="setting" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors appearance-none">
            <option value="">Select...</option>
            <option value="Indoor">Indoor</option>
            <option value="Outdoor">Outdoor</option>
            <option value="Both">Both/Mixed</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Event Type</label>
          <input type="text" name="event_type" placeholder="e.g. Festival, Corporate Gala" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
      </div>
    </div>

    <!-- Projection Surface Specifications -->
    <div class="space-y-4">
      <h4 class="font-heading font-bold text-sm text-brand-blue uppercase tracking-wide border-b border-brand-border pb-2">Projection Surface</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Surface Type *</label>
          <select name="surface_type" required class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors appearance-none">
            <option value="">Select a surface type...</option>
            <option value="Building facade">Building facade</option>
            <option value="Interior wall">Interior wall</option>
            <option value="Stage backdrop">Stage backdrop</option>
            <option value="Corporate space">Corporate space</option>
            <option value="Product display">Product display</option>
            <option value="Art installation">Art installation</option>
            <option value="Custom object">Custom object</option>
            <option value="Not sure yet">Not sure yet</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-muted mb-2">Approximate Surface Dimensions</label>
          <input type="text" name="surface_dimensions" placeholder="e.g. 40ft wide x 20ft tall" class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors" />
        </div>
      </div>
    </div>

    <!-- Content & Production Needs -->
    <div class="space-y-4">
      <h4 class="font-heading font-bold text-sm text-brand-blue uppercase tracking-wide border-b border-brand-border pb-2">Content & Production Needs</h4>
      <div class="border border-brand-border rounded-lg p-4 bg-brand-bg/50 space-y-3">
        <label class="flex items-center gap-3 cursor-pointer group">
          <input type="checkbox" name="content_available" class="w-4 h-4 bg-brand-bg border-brand-border rounded focus:ring-brand-blue accent-brand-blue" />
          <span class="text-sm text-brand-muted group-hover:text-white transition-colors">Content already available</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer group">
          <input type="checkbox" name="custom_content_needed" class="w-4 h-4 bg-brand-bg border-brand-border rounded focus:ring-brand-blue accent-brand-blue" />
          <span class="text-sm text-brand-muted group-hover:text-white transition-colors">Custom content needed</span>
        </label>
        <label class="flex items-center gap-3 cursor-pointer group">
          <input type="checkbox" name="live_operation_needed" class="w-4 h-4 bg-brand-bg border-brand-border rounded focus:ring-brand-blue accent-brand-blue" />
          <span class="text-sm text-brand-muted group-hover:text-white transition-colors">Live operation needed</span>
        </label>
      </div>
    </div>

    <!-- Additional Details -->
    <div>
      <label class="block text-sm font-medium text-brand-muted mb-2">Project Description</label>
      <textarea name="message" rows="4" placeholder="Tell us about your creative goals and visual ideas..." class="w-full bg-brand-bg border border-brand-border rounded-lg px-4 py-3 text-white focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none transition-colors resize-none"></textarea>
    </div>

    <!-- Consent -->
    <div class="flex items-start gap-3 border-t border-brand-border pt-6">
      <div class="flex items-center h-5 mt-1">
        <input id="consent-check" name="consent" type="checkbox" required class="w-4 h-4 bg-brand-bg border-brand-border rounded focus:ring-brand-blue accent-brand-blue cursor-pointer" />
      </div>
      <label for="consent-check" class="text-xs text-brand-muted leading-relaxed cursor-pointer hover:text-white transition-colors">
        I consent to AvValley contacting me regarding this projection mapping inquiry. Your information is kept secure according to our privacy policy.
      </label>
    </div>

    <button type="submit" class="w-full bg-brand-blue hover:bg-brand-hover text-white px-8 py-4 rounded font-heading font-bold uppercase tracking-wider transition-colors shadow-[0_0_15px_rgba(22,154,220,0.3)]">
      Request A Mapping Consultation
    </button>
  </form>
</div>

<script define:vars={{ id }}>
  const form = document.getElementById(id);
  const successDiv = document.getElementById(`${id}-success`);
  const submitBtn = form?.querySelector('button[type="submit"]');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Disable button during submission
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'SUBMITTING...';
      }

      try {
        // Collect form data
        const formDataObj = new FormData(form);
        const data = Object.fromEntries(formDataObj.entries());
        data.service = 'projection-mapping';

        // Submit to API endpoint
        const response = await fetch('/api/submit-form', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (result.success) {
          // Show success message
          form.style.display = 'none';
          successDiv.classList.remove('hidden');

          // Reset form after delay
          setTimeout(() => {
            form.reset();
            form.style.display = '';
            successDiv.classList.add('hidden');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Request A Mapping Consultation';
            }
          }, 3000);
        } else {
          alert(`Error: ${result.error || 'Failed to submit form'}`);
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Request A Mapping Consultation';
          }
        }
      } catch (error) {
        console.error('Form submission error:', error);
        alert('An error occurred while submitting the form. Please try again.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Request A Mapping Consultation';
        }
      }
    });
  }
</script>
