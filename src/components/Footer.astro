---

<footer class="bg-[#0B1525] pt-16 pb-24 md:pb-8 border-t border-brand-border">
  <div class="max-w-container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12 border-b border-brand-border pb-12">
      <!-- Brand -->
      <div class="lg:pr-8">
        <a href="/" class="flex items-center mb-4 group focus:outline-none">
          <img src="/images/AVValley-Logo.png" alt="AvValley Logo" class="h-12 w-auto group-hover:opacity-90 transition-opacity" />
        </a>
        <p class="text-brand-muted text-sm leading-relaxed mb-6">
          Professional outdoor stage and AV rentals for events, churches, festivals, conferences, and production companies.
        </p>
        <div class="flex gap-4">
          <a href="#" class="w-10 h-10 rounded-full bg-brand-card border border-brand-border flex items-center justify-center text-white hover:bg-brand-blue hover:border-brand-blue transition-colors focus:outline-none focus:ring-2 focus:ring-brand-blue" aria-label="Facebook">
            <i class="ph-fill ph-facebook-logo text-xl"></i>
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-brand-card border border-brand-border flex items-center justify-center text-white hover:bg-brand-blue hover:border-brand-blue transition-colors focus:outline-none focus:ring-2 focus:ring-brand-blue" aria-label="Instagram">
            <i class="ph-fill ph-instagram-logo text-xl"></i>
          </a>
          <a href="#" class="w-10 h-10 rounded-full bg-brand-card border border-brand-border flex items-center justify-center text-white hover:bg-brand-blue hover:border-brand-blue transition-colors focus:outline-none focus:ring-2 focus:ring-brand-blue" aria-label="LinkedIn">
            <i class="ph-fill ph-linkedin-logo text-xl"></i>
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="font-heading font-bold text-white mb-6 uppercase tracking-wider text-sm">Services</h4>
        <ul class="space-y-3">
          <li><a href="/mobile-stage-rental" class="text-brand-muted hover:text-brand-blue text-sm transition-colors focus:outline-none focus-visible:text-brand-blue">Mobile Stage Rentals</a></li>
          <li><a href="/purchase-projector" class="text-brand-muted hover:text-brand-blue text-sm transition-colors focus:outline-none focus-visible:text-brand-blue">Projectors for Sale</a></li>
          <li><a href="/projection-mapping" class="text-brand-muted hover:text-brand-blue text-sm transition-colors focus:outline-none focus-visible:text-brand-blue">Projection Mapping</a></li>
          <li><a href="/silent-disco-rentals" class="text-brand-muted hover:text-brand-blue text-sm transition-colors focus:outline-none focus-visible:text-brand-blue">Silent Disco</a></li>
          <li><a href="/#av-packages" class="text-brand-muted hover:text-brand-blue text-sm transition-colors focus:outline-none focus-visible:text-brand-blue">Event AV Packages</a></li>
          <li><a href="/#led-walls" class="text-brand-muted hover:text-brand-blue text-sm transition-colors focus:outline-none focus-visible:text-brand-blue">LED Walls & Screens</a></li>
          <li><a href="/outdoor-movie-rentals" class="text-brand-muted hover:text-brand-blue text-sm transition-colors focus:outline-none focus-visible:text-brand-blue">Outdoor Movies</a></li>
        </ul>
      </div>

      <!-- Contact Us -->
      <div>
        <h4 class="font-heading font-bold text-white mb-6 uppercase tracking-wider text-sm">Contact Us</h4>
        <ul class="space-y-4">
          <li>
            <a href="tel:4805674215" class="flex items-center gap-3 text-brand-muted hover:text-brand-blue transition-colors text-sm group focus:outline-none focus-visible:text-brand-blue">
              <i class="ph-fill ph-phone text-xl text-brand-border group-hover:text-brand-blue transition-colors"></i>
              480-567-4215
            </a>
          </li>
          <li>
            <a href="mailto:info@avvalley.com" class="flex items-center gap-3 text-brand-muted hover:text-brand-blue transition-colors text-sm group focus:outline-none focus-visible:text-brand-blue">
              <i class="ph-fill ph-envelope-simple text-xl text-brand-border group-hover:text-brand-blue transition-colors"></i>
              info@avvalley.com
            </a>
          </li>
          <li class="flex items-start gap-3 text-brand-muted text-sm">
            <i class="ph-fill ph-map-pin text-xl text-brand-border mt-0.5"></i>
            <span>Serving Phoenix, Mesa, San Tan Valley, and surrounding Arizona communities.</span>
          </li>
        </ul>
      </div>

      <!-- CTA -->
      <div>
        <h4 class="font-heading font-bold text-white mb-6 uppercase tracking-wider text-sm">Ready to Start?</h4>
        <p class="text-brand-muted text-sm mb-4">Contact our team to discuss your event requirements.</p>
        <a href="/#quote" class="inline-block w-full text-center bg-transparent border-2 border-brand-blue text-white hover:bg-brand-blue hover:text-white px-6 py-3 rounded font-heading font-bold uppercase tracking-wider text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-brand-blue">
          Request a Quote
        </a>
      </div>
    </div>

    <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-brand-border">
      <p>© 2024 AvValley. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="#" class="hover:text-brand-muted transition-colors focus:outline-none focus-visible:text-brand-muted">Privacy Policy</a>
        <a href="#" class="hover:text-brand-muted transition-colors focus:outline-none focus-visible:text-brand-muted">Terms and Conditions</a>
      </div>
    </div>
  </div>
</footer>

<!-- Mobile CTA -->
<div class="fixed bottom-0 left-0 w-full bg-brand-card border-t border-brand-border p-3 flex gap-3 md:hidden z-40 shadow-[0_-5px_20px_rgba(0,0,0,0.5)]">
  <a href="tel:4805674215" class="flex-1 bg-transparent border border-brand-blue text-white flex items-center justify-center gap-2 py-3 rounded font-heading font-bold text-sm uppercase tracking-wider focus:outline-none focus:ring-2 focus:ring-brand-blue">
    <i class="ph-fill ph-phone"></i> Call
  </a>
  <a href="/#quote" class="flex-1 bg-brand-blue text-white flex items-center justify-center py-3 rounded font-heading font-bold text-sm uppercase tracking-wider shadow-[0_0_10px_rgba(22,154,220,0.3)] focus:outline-none focus:ring-2 focus:ring-white">
    Quote
  </a>
</div>
