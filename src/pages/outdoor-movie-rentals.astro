---
import BaseLayout from '../layouts/BaseLayout.astro';
import OutdoorMovieForm from '../components/forms/OutdoorMovieForm.astro';
import QuoteSection from '../components/QuoteSection.astro';
---

<BaseLayout
  title="Outdoor Movie Screen Rentals in Arizona | AvValley"
  description="Rent an outdoor movie screen, projector, and sound system for backyard movies, churches, schools, neighborhoods, corporate events, and community gatherings."
>
  <main class="flex-grow pt-20">
    <!-- Hero Section -->
    <section class="relative min-h-[60vh] flex items-center justify-center pt-12 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="https://avvalley.com/media/Air-Screen-For-Rent.jpg" alt="Outdoor movie screening at night with audience" class="w-full h-full object-cover object-center" />
        <div class="absolute inset-0 bg-brand-bg/80"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-brand-bg via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-6 text-center">
        <div class="animate-fade-in-up">
          <p class="text-brand-blue font-heading font-bold tracking-[0.2em] text-sm md:text-base mb-4">OUTDOOR MOVIE EXPERIENCES</p>
          <h1 class="font-heading font-bold text-3xl md:text-4xl lg:text-5xl leading-[1.1] uppercase mb-6 text-white text-balance drop-shadow-lg">
            Outdoor Movie<br/>Screen Rentals
          </h1>
          <p class="text-brand-muted text-lg md:text-xl max-w-3xl mx-auto mb-10 text-balance leading-relaxed">
            Create an outdoor movie night with a large-format screen, professional projection, event audio, and setup support for churches, schools, neighborhoods, businesses, and community events.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-6">
            <a href="#quote" class="w-full sm:w-auto bg-brand-blue hover:bg-brand-hover text-white px-8 py-4 rounded font-heading font-bold uppercase tracking-wider transition-all shadow-[0_0_20px_rgba(22,154,220,0.4)] hover:shadow-[0_0_30px_rgba(26,175,232,0.6)] hover:-translate-y-1">
              Check Screen Availability
            </a>
            <a href="#packages" class="w-full sm:w-auto bg-transparent border-2 border-brand-blue text-white hover:bg-brand-blue/10 px-8 py-4 rounded font-heading font-bold uppercase tracking-wider transition-all hover:-translate-y-1">
              Compare Screen Packages
            </a>
          </div>
          <p class="text-sm text-brand-muted">
            Backyard, community, and large-event screen options available.
          </p>
        </div>
      </div>
    </section>

    <!-- Screen Overview Section -->
    <section class="py-24 bg-white border-y border-gray-300 relative z-20">
      <div class="max-w-container mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="relative rounded-2xl overflow-hidden border border-brand-border shadow-2xl reveal group">
            <img src="https://avvalley.com/media/POOL-PARTY.jpg" alt="Large inflatable outdoor movie screen setup" class="w-full h-auto object-cover aspect-[4/3] group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-brand-bg/30 mix-blend-multiply pointer-events-none"></div>
          </div>

          <div class="reveal" style="transition-delay: 200ms;">
            <p class="text-brand-blue font-heading font-bold tracking-[0.2em] text-sm mb-3">BRING THE SCREEN TO YOUR LOCATION</p>
            <h2 class="font-heading font-bold text-4xl md:text-5xl uppercase text-brand-bg mb-6 leading-tight">Create a Complete Outdoor Movie Experience</h2>
            <div class="space-y-6 text-brand-dark text-lg leading-relaxed mb-8">
              <p>
                AvValley provides inflatable movie screens and available projection and sound packages for outdoor events. Rental options can be configured around the audience size, viewing distance, event location, power availability, and production requirements.
              </p>
              <p>
                Screen rentals can support private backyard events, church movie nights, school functions, neighborhood gatherings, corporate events, festivals, and larger community experiences.
              </p>
            </div>
            <a href="#quote" class="inline-block bg-transparent border-2 border-brand-blue text-brand-blue hover:bg-brand-blue hover:text-white px-8 py-3.5 rounded font-heading font-bold uppercase tracking-wider transition-colors">
              Discuss Your Movie Night
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Screen Packages Section -->
    <section id="packages" class="py-24 bg-brand-bg relative overflow-hidden">
      <div class="absolute top-1/3 right-0 -translate-y-1/2 w-[600px] h-[600px] bg-brand-blue/5 rounded-full blur-[150px] pointer-events-none"></div>

      <div class="max-w-container mx-auto px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <h2 class="font-heading font-bold text-4xl md:text-5xl uppercase text-white mb-4">Choose the Right Screen For Your Event</h2>
          <p class="text-brand-muted text-lg">
            Select the screen size that fits your venue, audience, and event needs.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Backyard Screen (Small) -->
          <div class="bg-brand-card border border-brand-border rounded-xl flex flex-col overflow-hidden reveal group hover:border-brand-blue transition-colors">
            <div class="p-8 border-b border-brand-border bg-brand-secondary">
              <h3 class="font-heading font-bold text-2xl text-white mb-2 group-hover:text-brand-blue transition-colors">Backyard Screen (Small)</h3>
              <p class="text-brand-muted text-sm">For intimate gatherings such as backyard parties or small group events.</p>
            </div>
            <div class="p-8 flex-grow flex flex-col">
              <div class="space-y-4 mb-8">
                <div class="flex justify-between border-b border-brand-border/50 pb-4 items-start gap-4">
                  <span class="text-brand-muted text-sm mt-2">Total Size</span>
                  <span class="text-white font-bold text-4xl">24′ x 14′</span>
                </div>
                <p class="text-brand-muted text-xs">(with border)</p>
              </div>

              <h4 class="font-heading font-bold text-white text-sm mb-4 uppercase tracking-wider">Includes:</h4>
              <ul class="space-y-2 mb-8 flex-grow">
                <li class="flex items-start gap-2 text-sm text-brand-muted"><i class="ph-bold ph-check text-brand-blue mt-0.5"></i> HD projector & audio system</li>
                <li class="flex items-start gap-2 text-sm text-brand-muted"><i class="ph-bold ph-check text-brand-blue mt-0.5"></i> Delivery, setup & pickup</li>
                <li class="flex items-start gap-2 text-sm text-brand-muted"><i class="ph-bold ph-check text-brand-blue mt-0.5"></i> Basic seating arrangement guidance</li>
                <li class="flex items-start gap-2 text-sm text-brand-muted"><i class="ph-bold ph-check text-brand-blue mt-0.5"></i> Extension cords & power strips</li>
              </ul>

              <a href="#quote" class="w-full text-center bg-transparent border border-brand-border hover:border-brand-blue text-white px-6 py-3 rounded font-heading font-bold text-sm uppercase tracking-wider transition-colors mt-auto">
                Inquire For Price
              </a>
            </div>
          </div>

          <!-- Giant Screen (Large) -->
          <div class="bg-brand-card border border-brand-border rounded-xl flex flex-col overflow-hidden reveal group hover:border-brand-blue transition-colors" style="transition-delay: 100ms;">
            <div class="p-8 border-b border-brand-border bg-brand-secondary">
              <h3 class="font-heading font-bold text-2xl text-white mb-2 group-hover:text-brand-blue transition-colors">Giant Screen (Large)</h3>
              <p class="text-brand-muted text-sm">Built for large audiences and big-event atmospheres.</p>
            </div>
            <div class="p-8 flex-grow flex flex-col">
              <div class="space-y-4 mb-8">
                <div class="flex justify-between border-b border-brand-border/50 pb-4 items-start gap-4">
                  <span class="text-brand-muted text-sm mt-2">Total Size</span>
                  <span class="text-white font-bold text-4xl">40′ x 22′</span>
                </div>
                <p class="text-brand-muted text-xs">(with border)</p>
              </div>

              <h4 class="font-heading font-bold text-white text-sm mb-4 uppercase tracking-wider">Includes:</h4>
              <ul class="space-y-2 mb-8 flex-grow">
                <li class="flex items-start gap-2 text-sm text-brand-muted"><i class="ph-bold ph-check text-brand-blue mt-0.5"></i> HD projector & audio system</li>
                <li class="flex items-start gap-2 text-sm text-brand-muted"><i class="ph-bold ph-check text-brand-blue mt-0.5"></i> Delivery, setup & pickup</li>
                <li class="flex items-start gap-2 text-sm text-brand-muted"><i class="ph-bold ph-check text-brand-blue mt-0.5"></i> Basic seating arrangement guidance</li>
                <li class="flex items-start gap-2 text-sm text-brand-muted"><i class="ph-bold ph-check text-brand-blue mt-0.5"></i> Extension cords & power strips</li>
              </ul>

              <a href="#quote" class="w-full text-center bg-transparent border border-brand-border hover:border-brand-blue text-white px-6 py-3 rounded font-heading font-bold text-sm uppercase tracking-wider transition-colors mt-auto">
                Inquire For Price
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Services Section -->
    <section class="py-24 bg-white border-t border-gray-300">
      <div class="max-w-container mx-auto px-6">
        <div class="text-center mb-16 reveal">
          <h2 class="font-heading font-bold text-4xl uppercase text-brand-bg mb-4">Enhance Your Outdoor Event</h2>
          <p class="text-brand-dark text-lg">Pair your movie screen with other professional rental services.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          <a href="/rent-projector" class="relative h-48 rounded-xl overflow-hidden group border border-brand-border reveal card-gradient">
            <img src="https://avvalley.com/media/Christie HD14K-M 12,500 Lumen.webp" alt="Projector Rentals" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-6">
              <h3 class="font-heading font-bold text-xl text-white group-hover:text-brand-blue transition-colors">Projector Rentals</h3>
            </div>
          </a>
          <a href="/mobile-stage-rental" class="relative h-48 rounded-xl overflow-hidden group border border-brand-border reveal card-gradient" style="transition-delay: 100ms;">
            <img src="https://avvalley.com/media/stage-banner.jpg" alt="Mobile Stage" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-6">
              <h3 class="font-heading font-bold text-xl text-white group-hover:text-brand-blue transition-colors">Mobile Stage Rental</h3>
            </div>
          </a>
          <a href="/silent-disco-rentals" class="relative h-48 rounded-xl overflow-hidden group border border-brand-border reveal card-gradient" style="transition-delay: 200ms;">
            <img src="https://avvalley.com/media/Avvalley-silen-disco-corporate.webp" alt="Silent Disco" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-6">
              <h3 class="font-heading font-bold text-xl text-white group-hover:text-brand-blue transition-colors">Silent Disco Rentals</h3>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- Quote Form Section -->
    <section id="quote" class="py-24 bg-brand-bg border-t border-brand-border relative overflow-hidden">
      <div class="absolute top-0 right-0 w-full h-full bg-brand-secondary/30 pointer-events-none"></div>

      <div class="max-w-6xl mx-auto px-6 relative z-10">
        <div class="text-center mb-16 reveal">
          <h2 class="font-heading font-bold text-4xl md:text-5xl uppercase text-white mb-4">Check Movie Screen Availability</h2>
          <p class="text-brand-muted text-lg max-w-2xl mx-auto">
            Tell us about your event so AvValley can recommend the appropriate screen, projection, sound, and support package.
          </p>
        </div>

        <QuoteSection contactHeading="Contact Information">
          <OutdoorMovieForm id="outdoor-movie-form" />
        </QuoteSection>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="py-24 bg-white border-t border-brand-border">
      <div class="max-w-3xl mx-auto px-6">
        <div class="text-center mb-12 reveal">
          <h2 class="font-heading font-bold text-3xl md:text-4xl uppercase text-brand-bg mb-4">Outdoor Movie Rental Questions</h2>
        </div>

        <div class="space-y-4 reveal" id="faq-container">
          <div class="border border-gray-300 bg-brand-grey rounded-lg overflow-hidden faq-item">
            <button class="w-full text-left px-6 py-5 flex justify-between items-center focus:outline-none hover:bg-gray-200 transition-colors">
              <span class="font-bold text-brand-bg text-sm md:text-base pr-8">1. What screen sizes are available?</span>
              <i class="ph-bold ph-caret-down text-brand-blue transition-transform duration-300 transform faq-icon shrink-0"></i>
            </button>
            <div class="max-h-0 overflow-hidden transition-all duration-300 faq-content">
              <div class="px-6 pb-5 text-brand-dark text-sm leading-relaxed border-t border-gray-300 pt-4 mt-1">
                AvValley offers multiple screen sizes to accommodate different venue sizes and audience capacities, from small backyard gatherings to large community events and festivals.
              </div>
            </div>
          </div>

          <div class="border border-gray-300 bg-brand-grey rounded-lg overflow-hidden faq-item">
            <button class="w-full text-left px-6 py-5 flex justify-between items-center focus:outline-none hover:bg-gray-200 transition-colors">
              <span class="font-bold text-brand-bg text-sm md:text-base pr-8">2. How far in advance should I book?</span>
              <i class="ph-bold ph-caret-down text-brand-blue transition-transform duration-300 transform faq-icon shrink-0"></i>
            </button>
            <div class="max-h-0 overflow-hidden transition-all duration-300 faq-content">
              <div class="px-6 pb-5 text-brand-dark text-sm leading-relaxed border-t border-gray-300 pt-4 mt-1">
                We recommend booking as early as possible to ensure availability, especially for peak seasons. Contact us to check dates for your event.
              </div>
            </div>
          </div>

          <div class="border border-gray-300 bg-brand-grey rounded-lg overflow-hidden faq-item">
            <button class="w-full text-left px-6 py-5 flex justify-between items-center focus:outline-none hover:bg-gray-200 transition-colors">
              <span class="font-bold text-brand-bg text-sm md:text-base pr-8">3. What's included in the rental?</span>
              <i class="ph-bold ph-caret-down text-brand-blue transition-transform duration-300 transform faq-icon shrink-0"></i>
            </button>
            <div class="max-h-0 overflow-hidden transition-all duration-300 faq-content">
              <div class="px-6 pb-5 text-brand-dark text-sm leading-relaxed border-t border-gray-300 pt-4 mt-1">
                Our packages include the inflatable screen, projector, audio system, setup, and basic support. Additional services like delivery, operators, and lighting can be added.
              </div>
            </div>
          </div>

          <div class="border border-gray-300 bg-brand-grey rounded-lg overflow-hidden faq-item">
            <button class="w-full text-left px-6 py-5 flex justify-between items-center focus:outline-none hover:bg-gray-200 transition-colors">
              <span class="font-bold text-brand-bg text-sm md:text-base pr-8">4. What happens if it rains?</span>
              <i class="ph-bold ph-caret-down text-brand-blue transition-transform duration-300 transform faq-icon shrink-0"></i>
            </button>
            <div class="max-h-0 overflow-hidden transition-all duration-300 faq-content">
              <div class="px-6 pb-5 text-brand-dark text-sm leading-relaxed border-t border-gray-300 pt-4 mt-1">
                Weather impacts outdoor events. We'll discuss rescheduling options and weather policies when you request your quote. A backup rain date is recommended.
              </div>
            </div>
          </div>

          <div class="border border-gray-300 bg-brand-grey rounded-lg overflow-hidden faq-item">
            <button class="w-full text-left px-6 py-5 flex justify-between items-center focus:outline-none hover:bg-gray-200 transition-colors">
              <span class="font-bold text-brand-bg text-sm md:text-base pr-8">5. Can I show any movie?</span>
              <i class="ph-bold ph-caret-down text-brand-blue transition-transform duration-300 transform faq-icon shrink-0"></i>
            </button>
            <div class="max-h-0 overflow-hidden transition-all duration-300 faq-content">
              <div class="px-6 pb-5 text-brand-dark text-sm leading-relaxed border-t border-gray-300 pt-4 mt-1">
                For public performances, you may need public performance licensing. AvValley provides equipment and technical support, but the event organizer is responsible for obtaining required licenses.
              </div>
            </div>
          </div>

          <div class="border border-gray-300 bg-brand-grey rounded-lg overflow-hidden faq-item">
            <button class="w-full text-left px-6 py-5 flex justify-between items-center focus:outline-none hover:bg-gray-200 transition-colors">
              <span class="font-bold text-brand-bg text-sm md:text-base pr-8">6. Do you provide delivery and setup?</span>
              <i class="ph-bold ph-caret-down text-brand-blue transition-transform duration-300 transform faq-icon shrink-0"></i>
            </button>
            <div class="max-h-0 overflow-hidden transition-all duration-300 faq-content">
              <div class="px-6 pb-5 text-brand-dark text-sm leading-relaxed border-t border-gray-300 pt-4 mt-1">
                Yes, delivery and professional setup are available as add-ons. Our team can handle everything from delivery to testing to ensure a smooth event.
              </div>
            </div>
          </div>

          <div class="border border-gray-300 bg-brand-grey rounded-lg overflow-hidden faq-item">
            <button class="w-full text-left px-6 py-5 flex justify-between items-center focus:outline-none hover:bg-gray-200 transition-colors">
              <span class="font-bold text-brand-bg text-sm md:text-base pr-8">7. What audio options are available?</span>
              <i class="ph-bold ph-caret-down text-brand-blue transition-transform duration-300 transform faq-icon shrink-0"></i>
            </button>
            <div class="max-h-0 overflow-hidden transition-all duration-300 faq-content">
              <div class="px-6 pb-5 text-brand-dark text-sm leading-relaxed border-t border-gray-300 pt-4 mt-1">
                We offer various audio configurations from compact speakers to full event sound systems. For noise-restricted areas, silent disco headphones can be combined with the movie screen.
              </div>
            </div>
          </div>

          <div class="border border-gray-300 bg-brand-grey rounded-lg overflow-hidden faq-item">
            <button class="w-full text-left px-6 py-5 flex justify-between items-center focus:outline-none hover:bg-gray-200 transition-colors">
              <span class="font-bold text-brand-bg text-sm md:text-base pr-8">8. What if I have power limitations?</span>
              <i class="ph-bold ph-caret-down text-brand-blue transition-transform duration-300 transform faq-icon shrink-0"></i>
            </button>
            <div class="max-h-0 overflow-hidden transition-all duration-300 faq-content">
              <div class="px-6 pb-5 text-brand-dark text-sm leading-relaxed border-t border-gray-300 pt-4 mt-1">
                Tell us about your available power. We can work with generators, confirm requirements, and plan accordingly to ensure your event runs smoothly.
              </div>
            </div>
          </div>

          <div class="border border-gray-300 bg-brand-grey rounded-lg overflow-hidden faq-item">
            <button class="w-full text-left px-6 py-5 flex justify-between items-center focus:outline-none hover:bg-gray-200 transition-colors">
              <span class="font-bold text-brand-bg text-sm md:text-base pr-8">9. Can you handle multi-day events?</span>
              <i class="ph-bold ph-caret-down text-brand-blue transition-transform duration-300 transform faq-icon shrink-0"></i>
            </button>
            <div class="max-h-0 overflow-hidden transition-all duration-300 faq-content">
              <div class="px-6 pb-5 text-brand-dark text-sm leading-relaxed border-t border-gray-300 pt-4 mt-1">
                Yes, multi-day rentals are available with potential discounts. We can handle setup, storage, and takedown for events spanning multiple days.
              </div>
            </div>
          </div>

          <div class="border border-gray-300 bg-brand-grey rounded-lg overflow-hidden faq-item">
            <button class="w-full text-left px-6 py-5 flex justify-between items-center focus:outline-none hover:bg-gray-200 transition-colors">
              <span class="font-bold text-brand-bg text-sm md:text-base pr-8">10. How is pricing determined?</span>
              <i class="ph-bold ph-caret-down text-brand-blue transition-transform duration-300 transform faq-icon shrink-0"></i>
            </button>
            <div class="max-h-0 overflow-hidden transition-all duration-300 faq-content">
              <div class="px-6 pb-5 text-brand-dark text-sm leading-relaxed border-t border-gray-300 pt-4 mt-1">
                Pricing depends on screen size, location, equipment, delivery, setup, support, and event duration. Request a quote with your details for an accurate estimate.
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Reveal animations
      const revealElements = document.querySelectorAll('.reveal');
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
            revealObserver.unobserve(entry.target);
          }
        });
      }, {
        root: null,
        threshold: 0.15,
        rootMargin: "0px 0px -50px 0px"
      });

      revealElements.forEach(el => revealObserver.observe(el));

      // FAQ Accordion
      const faqItems = document.querySelectorAll('.faq-item');
      faqItems.forEach(item => {
        const button = item.querySelector('button');
        const content = item.querySelector('.faq-content');
        const icon = item.querySelector('.faq-icon');

        button.addEventListener('click', () => {
          const isOpen = content.style.maxHeight;
          faqItems.forEach(otherItem => {
            const otherContent = otherItem.querySelector('.faq-content');
            const otherIcon = otherItem.querySelector('.faq-icon');
            otherContent.style.maxHeight = null;
            otherIcon.classList.remove('rotate-180');
          });

          if (!isOpen) {
            content.style.maxHeight = content.scrollHeight + "px";
            icon.classList.add('rotate-180');
          } else {
            content.style.maxHeight = null;
            icon.classList.remove('rotate-180');
          }
        });
      });

    });
  </script>
</BaseLayout>
