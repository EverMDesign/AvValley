---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectorPurchaseForm from '../components/forms/ProjectorPurchaseForm.astro';
import QuoteSection from '../components/QuoteSection.astro';
import { getProjectorPurchaseSchema } from '../lib/schemas';

const purchaseSchema = getProjectorPurchaseSchema();
---

<BaseLayout
  title="Buy Professional Projectors | AvValley"
  description="Purchase high-performance Christie and Barco projectors for outdoor events, churches, corporate venues, and production companies. Professional-grade equipment with warranty and support."
>
  <main class="flex-grow pt-12">
    <!-- Schema Markup -->
    <script type="application/ld+json" set:html={JSON.stringify(purchaseSchema)} />

    <!-- Hero Section -->
    <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1535016120754-fd5ac57d8b65?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80" alt="Professional projector in use at large event" class="w-full h-full object-cover object-center" />
        <div class="absolute inset-0 bg-brand-bg/85"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-brand-bg via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-6 text-center my-12">
        <div class="animate-fade-in-up">
          <p class="text-brand-blue font-heading font-bold tracking-[0.2em] text-sm md:text-base mb-4">PROFESSIONAL PROJECTOR SALES</p>
          <h1 class="font-heading font-bold text-3xl md:text-4xl lg:text-5xl leading-[1.1] uppercase mb-6 text-white text-balance drop-shadow-lg">
            Purchase<br/>Professional Projectors
          </h1>
          <p class="text-brand-muted text-lg md:text-xl max-w-3xl mx-auto mb-10 text-balance leading-relaxed">
            High-performance Christie and Barco projectors for outdoor events, churches, venues, corporate installations, and production companies. Direct purchase with full warranty and technical support.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-6">
            <a href="#products" class="w-full sm:w-auto bg-brand-blue hover:bg-brand-hover text-white px-8 py-4 rounded font-heading font-bold uppercase tracking-wider transition-all shadow-[0_0_20px_rgba(22,154,220,0.4)] hover:shadow-[0_0_30px_rgba(26,175,232,0.6)] hover:-translate-y-1">
              Browse Available Models
            </a>
            <a href="#quote" class="w-full sm:w-auto bg-transparent border-2 border-brand-blue text-white hover:bg-brand-blue/10 px-8 py-4 rounded font-heading font-bold uppercase tracking-wider transition-all hover:-translate-y-1">
              Request Quote
            </a>
          </div>
          <p class="text-sm text-brand-muted">
            New and premium refurbished units available for immediate delivery.
          </p>
        </div>
      </div>
    </section>

    <!-- Product Inventory Section -->
    <section id="products" class="py-24 bg-white border-y border-brand-border relative z-20">
      <div class="max-w-container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <h2 class="font-heading font-bold text-4xl md:text-5xl uppercase text-brand-bg mb-4">Available Projector Models</h2>
          <p class="text-brand-dark text-lg">
            Professional-grade projectors for outdoor venues, large events, and institutional installations. Each unit includes comprehensive warranty and technical support.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Christie Model 1 -->
          <div class="bg-brand-grey border border-gray-300 rounded-xl overflow-hidden reveal group hover:border-brand-blue transition-colors flex flex-col">
            <div class="relative h-48 bg-gray-200 overflow-hidden">
              <img src="https://avvalley.com/media/Christie Roadster HD20K-J.webp" alt="Christie professional projector" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute top-4 right-4 bg-brand-blue/90 text-white px-3 py-1 rounded text-xs font-bold">IN STOCK</div>
            </div>
            <div class="p-8 flex flex-col flex-grow">
              <h3 class="font-heading font-bold text-xl text-brand-bg mb-2 group-hover:text-brand-blue transition-colors">Christie Roadster HD20K-J</h3>
              <p class="text-brand-dark text-sm mb-4">High brightness for large venues and outdoor installations</p>

              <ul class="space-y-2 mb-6 text-sm text-brand-dark flex-grow">
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>20,000 lumens</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>HD resolution</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>All lens available</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Professional-grade performance</li>
              </ul>

              <div class="border-t border-gray-300 pt-4 mb-6">
                <p class="text-brand-bg font-bold text-2xl">Contact for Pricing</p>
              </div>

              <a href="#quote" class="w-full text-center bg-transparent border border-gray-300 hover:border-brand-blue text-brand-bg hover:bg-brand-blue/10 px-4 py-3 rounded font-heading font-bold text-sm uppercase tracking-wider transition-colors">
                Request Info
              </a>
            </div>
          </div>

          <!-- Christie Model 2 -->
          <div class="bg-brand-grey border border-gray-300 rounded-xl overflow-hidden reveal group hover:border-brand-blue transition-colors flex flex-col" style="transition-delay: 100ms;">
            <div class="relative h-48 bg-gray-200 overflow-hidden">
              <img src="https://avvalley.com/media/Christie HD14K-M 12,500 Lumen.webp" alt="Christie professional projector" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute top-4 right-4 bg-brand-blue/90 text-white px-3 py-1 rounded text-xs font-bold">IN STOCK</div>
            </div>
            <div class="p-8 flex flex-col flex-grow">
              <h3 class="font-heading font-bold text-xl text-brand-bg mb-2 group-hover:text-brand-blue transition-colors">Christie HD14K-M</h3>
              <p class="text-brand-dark text-sm mb-4">Reliable dual-lamp projection for professional venues</p>

              <ul class="space-y-2 mb-6 text-sm text-brand-dark flex-grow">
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>12,500 lumens</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>HD 3DLP Dual-Lamp</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>All lens available</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Year 2017 model</li>
              </ul>

              <div class="border-t border-gray-300 pt-4 mb-6">
                <p class="text-brand-bg font-bold text-2xl">Contact for Pricing</p>
              </div>

              <a href="#quote" class="w-full text-center bg-transparent border border-gray-300 hover:border-brand-blue text-brand-bg hover:bg-brand-blue/10 px-4 py-3 rounded font-heading font-bold text-sm uppercase tracking-wider transition-colors">
                Request Info
              </a>
            </div>
          </div>

          <!-- Barco Model 1 -->
          <div class="bg-brand-grey border border-gray-300 rounded-xl overflow-hidden reveal group hover:border-brand-blue transition-colors flex flex-col" style="transition-delay: 200ms;">
            <div class="relative h-48 bg-gray-200 overflow-hidden">
              <img src="https://avvalley.com/media/Barco HDX-W20 FLEX WUXGA DLP.webp" alt="Barco professional projector" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute top-4 right-4 bg-amber-600/90 text-white px-3 py-1 rounded text-xs font-bold">PRE-ORDER</div>
            </div>
            <div class="p-8 flex flex-col flex-grow">
              <h3 class="font-heading font-bold text-xl text-brand-bg mb-2 group-hover:text-brand-blue transition-colors">Barco HDX-W20 FLEX</h3>
              <p class="text-brand-dark text-sm mb-4">Flexible brightness and setup for diverse venues</p>

              <ul class="space-y-2 mb-6 text-sm text-brand-dark flex-grow">
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>20,000 lumens</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>WUXGA DLP</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>All lens available</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Flexible brightness and setup</li>
              </ul>

              <div class="border-t border-gray-300 pt-4 mb-6">
                <p class="text-brand-bg font-bold text-2xl">Contact for Pricing</p>
              </div>

              <a href="#quote" class="w-full text-center bg-transparent border border-gray-300 hover:border-brand-blue text-brand-bg hover:bg-brand-blue/10 px-4 py-3 rounded font-heading font-bold text-sm uppercase tracking-wider transition-colors">
                Request Info
              </a>
            </div>
          </div>

          <!-- Barco Model 2 -->
          <div class="bg-brand-grey border border-gray-300 rounded-xl overflow-hidden reveal group hover:border-brand-blue transition-colors flex flex-col" style="transition-delay: 100ms;">
            <div class="relative h-48 bg-gray-200 overflow-hidden">
              <img src="https://avvalley.com/media/Barco RLM-W12 11,500 Lumens.webp" alt="Barco professional projector" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute top-4 right-4 bg-brand-blue/90 text-white px-3 py-1 rounded text-xs font-bold">IN STOCK</div>
            </div>
            <div class="p-8 flex flex-col flex-grow">
              <h3 class="font-heading font-bold text-xl text-brand-bg mb-2 group-hover:text-brand-blue transition-colors">Barco RLM-W12</h3>
              <p class="text-brand-dark text-sm mb-4">Portable setup for flexible venue installations</p>

              <ul class="space-y-2 mb-6 text-sm text-brand-dark flex-grow">
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>11,500 lumens</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>WUXGA 3-Chip DLP</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>All lens available</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Portable setup</li>
              </ul>

              <div class="border-t border-gray-300 pt-4 mb-6">
                <p class="text-brand-bg font-bold text-2xl">Contact for Pricing</p>
              </div>

              <a href="#quote" class="w-full text-center bg-transparent border border-gray-300 hover:border-brand-blue text-brand-bg hover:bg-brand-blue/10 px-4 py-3 rounded font-heading font-bold text-sm uppercase tracking-wider transition-colors">
                Request Info
              </a>
            </div>
          </div>

          <!-- Barco Model 3 -->
          <div class="bg-brand-grey border border-gray-300 rounded-xl overflow-hidden reveal group hover:border-brand-blue transition-colors flex flex-col" style="transition-delay: 300ms;">
            <div class="relative h-48 bg-gray-200 overflow-hidden">
              <img src="https://avvalley.com/media/Barco RLM-W8 WUXGA 8000 Lumen.webp" alt="Barco professional projector" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute top-4 right-4 bg-brand-blue/90 text-white px-3 py-1 rounded text-xs font-bold">IN STOCK</div>
            </div>
            <div class="p-8 flex flex-col flex-grow">
              <h3 class="font-heading font-bold text-xl text-brand-bg mb-2 group-hover:text-brand-blue transition-colors">Barco RLM-W8</h3>
              <p class="text-brand-dark text-sm mb-4">Compact unit with integrated lens options</p>

              <ul class="space-y-2 mb-6 text-sm text-brand-dark flex-grow">
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>8,000 lumens</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>WUXGA 3DLP</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>All lens available</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Compact unit with lens included</li>
              </ul>

              <div class="border-t border-gray-300 pt-4 mb-6">
                <p class="text-brand-bg font-bold text-2xl">Contact for Pricing</p>
              </div>

              <a href="#quote" class="w-full text-center bg-transparent border border-gray-300 hover:border-brand-blue text-brand-bg hover:bg-brand-blue/10 px-4 py-3 rounded font-heading font-bold text-sm uppercase tracking-wider transition-colors">
                Request Info
              </a>
            </div>
          </div>

          <!-- Additional Option -->
          <div class="bg-brand-grey border border-gray-300 rounded-xl overflow-hidden reveal group hover:border-brand-blue transition-colors flex flex-col" style="transition-delay: 400ms;">
            <div class="relative h-48 bg-gray-200 overflow-hidden flex items-center justify-center">
              <i class="ph-bold ph-magnifying-glass text-6xl text-gray-400/30"></i>
            </div>
            <div class="p-8 flex flex-col flex-grow">
              <h3 class="font-heading font-bold text-xl text-brand-bg mb-2 group-hover:text-brand-blue transition-colors">Custom Specifications</h3>
              <p class="text-brand-dark text-sm mb-4">Need different specs? We source projectors to your requirements.</p>

              <ul class="space-y-2 mb-6 text-sm text-brand-dark flex-grow">
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Custom lumen requirements</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Specialty lens options</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Budget-friendly solutions</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Quick turnaround sourcing</li>
              </ul>

              <div class="border-t border-gray-300 pt-4 mb-6">
                <p class="text-brand-bg font-bold text-lg">Let's Find It</p>
              </div>

              <a href="#quote" class="w-full text-center bg-brand-blue hover:bg-brand-hover text-white px-4 py-3 rounded font-heading font-bold text-sm uppercase tracking-wider transition-colors shadow-[0_0_10px_rgba(22,154,220,0.3)]">
                Inquire Now
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Buyer Guidance Section -->
    <section class="py-24 bg-brand-grey relative overflow-hidden">
      <div class="absolute top-1/3 right-0 -translate-y-1/2 w-[600px] h-[600px] bg-brand-blue/5 rounded-full blur-[150px] pointer-events-none"></div>

      <div class="max-w-container mx-auto px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <h2 class="font-heading font-bold text-4xl md:text-5xl uppercase text-brand-bg mb-4">Choosing the Right Projector</h2>
          <p class="text-brand-dark text-lg">
            Select the appropriate projector based on venue size, brightness requirements, resolution needs, and installation location.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Lumen Requirements -->
          <div class="bg-white border border-gray-300 rounded-xl p-8 reveal group hover:border-brand-blue transition-colors">
            <div class="w-12 h-12 rounded-lg bg-brand-blue/20 flex items-center justify-center mb-4">
              <i class="ph-bold ph-lightning text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-brand-bg mb-3 group-hover:text-brand-blue transition-colors">Brightness (Lumens)</h3>
            <p class="text-brand-dark text-sm leading-relaxed">
              Outdoor venues require higher lumen output (12,000+) than indoor spaces. Choose based on ambient light, screen size, and audience distance.
            </p>
          </div>

          <!-- Venue Size -->
          <div class="bg-white border border-gray-300 rounded-xl p-8 reveal group hover:border-brand-blue transition-colors" style="transition-delay: 100ms;">
            <div class="w-12 h-12 rounded-lg bg-brand-blue/20 flex items-center justify-center mb-4">
              <i class="ph-bold ph-ruler text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-brand-bg mb-3 group-hover:text-brand-blue transition-colors">Venue Size</h3>
            <p class="text-brand-dark text-sm leading-relaxed">
              Larger venues need higher lumens and longer throw distances. Small to medium venues may benefit from compact, lower-lumen models.
            </p>
          </div>

          <!-- Resolution Needs -->
          <div class="bg-white border border-gray-300 rounded-xl p-8 reveal group hover:border-brand-blue transition-colors" style="transition-delay: 200ms;">
            <div class="w-12 h-12 rounded-lg bg-brand-blue/20 flex items-center justify-center mb-4">
              <i class="ph-bold ph-monitor text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-brand-bg mb-3 group-hover:text-brand-blue transition-colors">Resolution</h3>
            <p class="text-brand-dark text-sm leading-relaxed">
              4K DCI projectors deliver sharper images for close viewing. WUXGA works well for outdoor events with general audiences.
            </p>
          </div>

          <!-- Installation Type -->
          <div class="bg-white border border-gray-300 rounded-xl p-8 reveal group hover:border-brand-blue transition-colors" style="transition-delay: 100ms;">
            <div class="w-12 h-12 rounded-lg bg-brand-blue/20 flex items-center justify-center mb-4">
              <i class="ph-bold ph-wrench text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-brand-bg mb-3 group-hover:text-brand-blue transition-colors">Installation</h3>
            <p class="text-brand-dark text-sm leading-relaxed">
              Fixed installations may benefit from permanent cooling and setup. Rental units should have quick setup and portable designs.
            </p>
          </div>

          <!-- Budget Considerations -->
          <div class="bg-white border border-gray-300 rounded-xl p-8 reveal group hover:border-brand-blue transition-colors" style="transition-delay: 200ms;">
            <div class="w-12 h-12 rounded-lg bg-brand-blue/20 flex items-center justify-center mb-4">
              <i class="ph-bold ph-currency-circle-dollar text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-brand-bg mb-3 group-hover:text-brand-blue transition-colors">Budget</h3>
            <p class="text-brand-dark text-sm leading-relaxed">
              Premium 4K models cost more but offer better image quality. Standard WUXGA options provide excellent value for general venues.
            </p>
          </div>

          <!-- Support & Warranty -->
          <div class="bg-white border border-gray-300 rounded-xl p-8 reveal group hover:border-brand-blue transition-colors" style="transition-delay: 100ms;">
            <div class="w-12 h-12 rounded-lg bg-brand-blue/20 flex items-center justify-center mb-4">
              <i class="ph-bold ph-shield-check text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-brand-bg mb-3 group-hover:text-brand-blue transition-colors">Warranty & Support</h3>
            <p class="text-brand-dark text-sm leading-relaxed">
              Comprehensive warranty and technical support protect your investment. AvValley offers maintenance plans and rapid response support.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Professional Applications Section -->
    <section class="py-24 bg-brand-bg border-y border-brand-border relative z-20">
      <div class="max-w-container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <h2 class="font-heading font-bold text-4xl md:text-5xl uppercase text-white mb-4">Perfect For These Applications</h2>
          <p class="text-brand-muted text-lg">
            Professional projectors suit diverse venues and organizations.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Churches & Worship -->
          <div class="bg-brand-card border border-brand-border rounded-xl overflow-hidden reveal group hover:border-brand-blue transition-colors">
            <div class="p-8">
              <h3 class="font-heading font-bold text-xl text-white mb-3 group-hover:text-brand-blue transition-colors">Churches & Worship</h3>
              <p class="text-brand-muted text-sm mb-4">
                Display lyrics, sermons, announcements, and worship visuals. Customizable software integration for synchronized presentations.
              </p>
              <ul class="space-y-2 text-sm text-brand-muted">
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Multiple screen layouts</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Flexible control systems</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Durable outdoor installations</li>
              </ul>
            </div>
          </div>

          <!-- Corporate Events & Conferences -->
          <div class="bg-brand-card border border-brand-border rounded-xl overflow-hidden reveal group hover:border-brand-blue transition-colors" style="transition-delay: 100ms;">
            <div class="p-8">
              <h3 class="font-heading font-bold text-xl text-white mb-3 group-hover:text-brand-blue transition-colors">Corporate & Conferences</h3>
              <p class="text-brand-muted text-sm mb-4">
                Presentations, keynotes, and live event coverage. Professional color accuracy and high resolution for detailed graphics.
              </p>
              <ul class="space-y-2 text-sm text-brand-muted">
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Color calibration included</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Scalable multi-screen setups</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>On-site technical support</li>
              </ul>
            </div>
          </div>

          <!-- Outdoor Venues & Entertainment -->
          <div class="bg-brand-card border border-brand-border rounded-xl overflow-hidden reveal group hover:border-brand-blue transition-colors" style="transition-delay: 200ms;">
            <div class="p-8">
              <h3 class="font-heading font-bold text-xl text-white mb-3 group-hover:text-brand-blue transition-colors">Outdoor Venues</h3>
              <p class="text-brand-muted text-sm mb-4">
                Concerts, festivals, movie nights, and sports events. High-lumen output for bright sunlight and large audience visibility.
              </p>
              <ul class="space-y-2 text-sm text-brand-muted">
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>High brightness outdoor specs</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Weatherproof construction</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Long throw capability</li>
              </ul>
            </div>
          </div>

          <!-- Educational Institutions -->
          <div class="bg-brand-card border border-brand-border rounded-xl overflow-hidden reveal group hover:border-brand-blue transition-colors" style="transition-delay: 100ms;">
            <div class="p-8">
              <h3 class="font-heading font-bold text-xl text-white mb-3 group-hover:text-brand-blue transition-colors">Educational Institutions</h3>
              <p class="text-brand-muted text-sm mb-4">
                Lecture halls, auditoriums, and outdoor classrooms. Reliable performance for academic presentations and student events.
              </p>
              <ul class="space-y-2 text-sm text-brand-muted">
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Bulk institutional pricing</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Educational discounts available</li>
                <li class="flex items-center gap-2"><i class="ph-bold ph-check text-brand-blue"></i>Flexible maintenance plans</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Purchase Process Section -->
    <section class="py-24 bg-brand-grey relative overflow-hidden">
      <div class="absolute top-1/4 left-0 -translate-y-1/2 w-[600px] h-[600px] bg-brand-blue/5 rounded-full blur-[150px] pointer-events-none"></div>

      <div class="max-w-container mx-auto px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
