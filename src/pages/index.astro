---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHomepageSchema, getOrganizationSchema, getFAQSchema } from '../lib/schemas';

const homepageSchema = getHomepageSchema();
const orgSchema = getOrganizationSchema();

const faqItems = [
  {
    question: "What types of events do you support?",
    answer: "We support a wide range of outdoor events including church services, worship nights, music festivals, concerts, corporate conferences, community gatherings, school events, outdoor movie nights, and more."
  },
  {
    question: "Can I rent the stage without a complete AV package?",
    answer: "Yes. You can rent just the mobile stage by itself, or you can build a custom package adding sound, lighting, or screens as needed for your specific event."
  },
  {
    question: "Do you provide delivery, setup, and teardown?",
    answer: "Absolutely. All of our rentals include professional delivery, setup, and teardown by our experienced crew to ensure everything is safe and ready for your event."
  },
  {
    question: "What information do you need to prepare a quote?",
    answer: "To provide an accurate quote, we need the event date, location, expected attendance, type of event, and an idea of what services you are interested in (stage only, full AV, etc.). Access details for the venue are also helpful."
  },
  {
    question: "Can you support live bands and worship teams?",
    answer: "Yes. We offer \"Band-Ready\" production packages that include line-array speakers, subwoofers, stage monitors, digital mixing consoles, microphones, and dynamic lighting suitable for full live bands."
  },
  {
    question: "Do you provide LED walls or outdoor movie screens?",
    answer: "Yes. We supply LED walls for daytime visibility or outdoor projection screens for evening movie nights. These can be integrated with the stage or set up independently."
  },
  {
    question: "Can other AV companies subrent your equipment?",
    answer: "Yes, we frequently work B2B. Production companies and AV providers can subrent our stages, sound systems, lighting, and screens to supplement their own inventory for client events."
  },
  {
    question: "What areas do you serve?",
    answer: "We primarily serve Phoenix, Mesa, Tempe, Chandler, Gilbert, Scottsdale, San Tan Valley, Litchfield Park, and all surrounding Arizona communities. We specialize in outdoor event rentals throughout Maricopa County and can accommodate events across Arizona for multi-day productions."
  },
  {
    question: "How far in advance should I reserve the stage?",
    answer: "We recommend booking as soon as your event date is confirmed, especially for busy seasons (Spring and Fall). A minimum of 30-60 days is ideal, but we can sometimes accommodate shorter notices based on availability."
  },
  {
    question: "What affects the final rental price?",
    answer: "Pricing is influenced by the specific equipment requested (stage size, amount of audio/lighting), duration of the rental, travel distance, labor requirements for setup/teardown, and any difficult venue access issues."
  }
];

const faqSchema = getFAQSchema(faqItems);
---

<BaseLayout>
  <main class="flex-grow" style="margin-top: 80px;">
    <!-- Schema Markup -->
    <script type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Hero Section -->
    <section class="relative min-h-[90vh] flex items-center justify-center pt-20 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src="https://avvalley.com/media/avValley-stage.jpg" alt="Large outdoor concert stage at night with professional lighting" class="w-full h-full object-cover object-center" />
        <div class="absolute inset-0 bg-brand-bg/85"></div>
      </div>

      <div class="relative z-10 max-w-container mx-auto px-6 text-center mt-12 mb-24">
        <div class="animate-fade-in-up">
          <p class="text-brand-blue font-heading font-bold tracking-[0.2em] text-sm md:text-base mb-4">OUTDOOR STAGE & AV RENTALS</p>
          <h1 class="font-heading font-bold text-5xl md:text-7xl lg:text-8xl leading-[1.1] uppercase mb-6 text-white text-balance drop-shadow-lg">
            Bring The Venue<br/>To Your Location.
          </h1>
          <p class="text-brand-muted text-lg md:text-xl max-w-3xl mx-auto mb-10 text-balance leading-relaxed">
            Host professional outdoor events in Phoenix, Scottsdale, Mesa, and throughout Arizona with stage rentals, sound systems, LED walls, and event-ready AV support—all coordinated through one experienced provider.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
            <a href="#quote" class="w-full sm:w-auto bg-brand-blue hover:bg-brand-hover text-white px-8 py-4 rounded font-heading font-bold uppercase tracking-wider transition-all shadow-[0_0_20px_rgba(22,154,220,0.4)] hover:shadow-[0_0_30px_rgba(26,175,232,0.6)] hover:-translate-y-1">
              Request A Quote
            </a>
            <a href="#av-packages" class="w-full sm:w-auto bg-transparent border-2 border-brand-blue text-white hover:bg-brand-blue/10 px-8 py-4 rounded font-heading font-bold uppercase tracking-wider transition-all hover:-translate-y-1">
              Explore Rental Options
            </a>
          </div>
          <div class="w-full flex flex-col items-center gap-4">
            <p class="text-sm text-brand-muted flex items-center justify-center gap-2">
              <i class="ph-fill ph-map-pin text-brand-blue shrink-0"></i>
              Serving Arizona Communities:
            </p>
            <div class="flex flex-wrap justify-center gap-2 max-w-4xl">
              <span class="inline-block bg-brand-blue/20 border border-brand-blue text-brand-blue px-3 py-1.5 rounded-full text-xs font-semibold tracking-wide hover:bg-brand-blue/30 transition-colors">Phoenix</span>
              <span class="inline-block bg-brand-blue/20 border border-brand-blue text-brand-blue px-3 py-1.5 rounded-full text-xs font-semibold tracking-wide hover:bg-brand-blue/30 transition-colors">Mesa</span>
              <span class="inline-block bg-brand-blue/20 border border-brand-blue text-brand-blue px-3 py-1.5 rounded-full text-xs font-semibold tracking-wide hover:bg-brand-blue/30 transition-colors">Tempe</span>
              <span class="inline-block bg-brand-blue/20 border border-brand-blue text-brand-blue px-3 py-1.5 rounded-full text-xs font-semibold tracking-wide hover:bg-brand-blue/30 transition-colors">Chandler</span>
              <span class="inline-block bg-brand-blue/20 border border-brand-blue text-brand-blue px-3 py-1.5 rounded-full text-xs font-semibold tracking-wide hover:bg-brand-blue/30 transition-colors">Gilbert</span>
              <span class="inline-block bg-brand-blue/20 border border-brand-blue text-brand-blue px-3 py-1.5 rounded-full text-xs font-semibold tracking-wide hover:bg-brand-blue/30 transition-colors">Scottsdale</span>
              <span class="inline-block bg-brand-blue/20 border border-brand-blue text-brand-blue px-3 py-1.5 rounded-full text-xs font-semibold tracking-wide hover:bg-brand-blue/30 transition-colors">San Tan Valley</span>
              <span class="inline-block bg-brand-blue/20 border border-brand-blue text-brand-blue px-3 py-1.5 rounded-full text-xs font-semibold tracking-wide hover:bg-brand-blue/30 transition-colors">Litchfield Park</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Bar -->
    <section class="bg-brand-secondary border-y border-brand-border relative z-20">
      <div class="max-w-container mx-auto px-6 py-6">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-6 md:gap-4 divide-x-0 md:divide-x divide-brand-border">
          <div class="flex items-center justify-center gap-3 px-4 reveal">
            <i class="ph ph-tent text-2xl text-brand-blue"></i>
            <span class="text-sm font-medium text-brand-text">Outdoor Event Specialists</span>
          </div>
          <div class="flex items-center justify-center gap-3 px-4 reveal" style="transition-delay: 100ms;">
            <i class="ph ph-speaker-hifi text-2xl text-brand-blue"></i>
            <span class="text-sm font-medium text-brand-text">Stage & AV Packages</span>
          </div>
          <div class="flex items-center justify-center gap-3 px-4 reveal" style="transition-delay: 200ms;">
            <i class="ph ph-wrench text-2xl text-brand-blue"></i>
            <span class="text-sm font-medium text-brand-text">Professional Setup Support</span>
          </div>
          <div class="flex items-center justify-center gap-3 px-4 reveal" style="transition-delay: 300ms;">
            <i class="ph ph-handshake text-2xl text-brand-blue"></i>
            <span class="text-sm font-medium text-brand-text">B2B Subrentals Available</span>
          </div>
          <div class="flex items-center justify-center gap-3 px-4 reveal" style="transition-delay: 400ms;">
            <i class="ph ph-package text-2xl text-brand-blue"></i>
            <span class="text-sm font-medium text-brand-text">Mobile Stage Rentals</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Stage Rentals Section -->
    <section id="stage-rentals" class="py-24 bg-white relative overflow-hidden">
      <div class="absolute top-1/2 left-0 -translate-y-1/2 w-[500px] h-[500px] bg-brand-blue/5 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="max-w-container mx-auto px-6 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <!-- Image -->
          <div class="relative rounded-2xl overflow-hidden border border-brand-border shadow-2xl reveal group">
            <img src="https://avvalley.com/media/IMG_2229.jpg" alt="22x20 Mobile Stage Setup" class="w-full h-auto object-cover aspect-[4/3] group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-brand-secondary/40 mix-blend-multiply pointer-events-none"></div>

            <div class="absolute bottom-6 right-6 bg-brand-bg/90 backdrop-blur border border-brand-border px-4 py-2 rounded-lg flex gap-4">
              <div class="text-center">
                <span class="block text-brand-blue font-bold text-xl">22'</span>
                <span class="text-xs text-brand-muted uppercase">Width</span>
              </div>
              <div class="w-px bg-brand-border"></div>
              <div class="text-center">
                <span class="block text-brand-blue font-bold text-xl">20'</span>
                <span class="text-xs text-brand-muted uppercase">Depth</span>
              </div>
            </div>
          </div>

          <!-- Content -->
          <div class="reveal" style="transition-delay: 200ms;">
            <p class="text-brand-blue font-heading font-bold tracking-[0.2em] text-sm mb-3">PRIMARY RENTAL</p>
            <h2 class="font-heading font-bold text-4xl md:text-5xl uppercase text-brand-bg mb-6 leading-tight">22′ × 20′ Mobile Stage Rental</h2>
            <p class="text-brand-dark text-lg mb-8 leading-relaxed">
              Create a professional focal point for festivals, church events, conferences, worship nights, concerts, community gatherings, and outdoor productions.
            </p>

            <ul class="flex flex-col gap-4 mb-10">
              <li class="flex items-start gap-3">
                <i class="ph-fill ph-check-circle text-brand-blue text-xl shrink-0 mt-0.5"></i>
                <span class="text-brand-dark">Professional mobile stage</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="ph-fill ph-check-circle text-brand-blue text-xl shrink-0 mt-0.5"></i>
                <span class="text-brand-dark">Delivery, setup, and teardown options</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="ph-fill ph-check-circle text-brand-blue text-xl shrink-0 mt-0.5"></i>
                <span class="text-brand-dark">Stage-only and full-production packages</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="ph-fill ph-check-circle text-brand-blue text-xl shrink-0 mt-0.5"></i>
                <span class="text-brand-dark">Sound, lighting, screens, and microphones available</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="ph-fill ph-check-circle text-brand-blue text-xl shrink-0 mt-0.5"></i>
                <span class="text-brand-dark">Single-day and multi-day rentals</span>
              </li>
            </ul>

            <div class="flex flex-col sm:flex-row gap-4">
              <a href="#quote" class="text-center bg-brand-blue hover:bg-brand-hover text-white px-8 py-3.5 rounded font-heading font-bold uppercase tracking-wider transition-colors shadow-[0_0_15px_rgba(22,154,220,0.3)] hover:shadow-[0_0_20px_rgba(26,175,232,0.5)]">
                Request Availability
              </a>
              <a href="/mobile-stage-rental" class="text-center bg-transparent border border-gray-300 hover:border-brand-blue text-brand-bg px-8 py-3.5 rounded font-heading font-bold uppercase tracking-wider transition-colors">
                View Stage Details
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- AV Packages Section -->
    <section id="av-packages" class="py-24 bg-brand-grey">
      <div class="max-w-container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <h2 class="font-heading font-bold text-4xl md:text-5xl uppercase text-brand-bg mb-4">Everything Your Event Needs</h2>
          <p class="text-brand-dark text-lg">
            Choose the stage by itself or combine it with professional sound, lighting, screens, microphones, and event-production support.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Package 1: Stage and Sound -->
          <a href="/mobile-stage-rental" class="relative h-[400px] rounded-xl overflow-hidden group border border-brand-border reveal card-gradient cursor-pointer block hover:no-underline">
            <img src="https://avvalley.com/media/stage-banner.jpg" alt="Stage and Sound" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-8">
              <h3 class="font-heading font-bold text-2xl text-white mb-2 group-hover:text-brand-blue transition-colors">Mobile Stage Rental</h3>
              <p class="text-brand-muted mb-4 line-clamp-2">Professional 22' × 20' mobile stage with sound, lighting, and equipment packages for outdoor events.</p>
            </div>
          </a>

          <!-- Package 2: LED Walls -->
          <a href="/projection-mapping" id="led-walls" class="relative h-[400px] rounded-xl overflow-hidden group border border-brand-border reveal card-gradient cursor-pointer block hover:no-underline" style="transition-delay: 100ms;">
            <img src="https://avvalley.com/media/Avalley-projection-mapping-concert.webp" alt="LED Walls" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-8">
              <h3 class="font-heading font-bold text-2xl text-white mb-2 group-hover:text-brand-blue transition-colors">Projection Mapping & LED Walls</h3>
              <p class="text-brand-muted mb-4 line-clamp-2">Professional projection mapping and LED displays for dynamic visuals, presentations, branding, and immersive event experiences.</p>
            </div>
          </a>

          <!-- Package 3: Outdoor Movies -->
          <a href="/outdoor-movie-rentals" id="outdoor-movies" class="relative h-[400px] rounded-xl overflow-hidden group border border-brand-border reveal card-gradient cursor-pointer block hover:no-underline" style="transition-delay: 200ms;">
            <img src="https://avvalley.com/media/POOL-PARTY.jpg" alt="Outdoor Movies" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-8">
              <h3 class="font-heading font-bold text-2xl text-white mb-2 group-hover:text-brand-blue transition-colors">Air Screen Movie Packages</h3>
              <p class="text-brand-muted mb-4 line-clamp-2">Professional air screens and projection for outdoor movie nights, backyard events, and community gatherings.</p>
            </div>
          </a>

          <!-- Package 4: Silent Disco Party -->
          <a href="/silent-disco-rentals" class="relative h-[400px] rounded-xl overflow-hidden group border border-brand-border reveal card-gradient cursor-pointer block hover:no-underline" style="transition-delay: 300ms;">
            <img src="https://avvalley.com/media/Avvalley-silent-disco-feastival.webp" alt="Silent Disco Party" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-8">
              <h3 class="font-heading font-bold text-2xl text-white mb-2 group-hover:text-brand-blue transition-colors">Silent Disco Party</h3>
              <p class="text-brand-muted mb-4 line-clamp-2">Wireless headphone systems for unique entertainment at weddings, corporate events, festivals, and private parties.</p>
            </div>
          </a>

        </div>
      </div>
    </section>

    <!-- Use Cases Section -->
    <section class="py-24 bg-brand-bg relative overflow-hidden">
      <div class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-brand-blue/5 rounded-full blur-[150px] pointer-events-none"></div>

      <div class="max-w-container mx-auto px-6 relative z-10">
        <div class="text-center mb-16 reveal">
          <h2 class="font-heading font-bold text-4xl uppercase text-white mb-4">Built For Arizona Events of Every Scale</h2>
          <div class="w-24 h-1 bg-brand-blue mx-auto rounded"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Use Case 1 -->
          <div class="bg-brand-card border border-brand-border p-8 rounded-xl hover:border-brand-blue transition-colors group reveal">
            <div class="w-12 h-12 bg-brand-bg rounded-lg border border-brand-border flex items-center justify-center mb-6 group-hover:bg-brand-blue/10 transition-colors">
              <i class="ph ph-church text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-white mb-3">Churches & Ministries</h3>
            <p class="text-brand-muted text-sm leading-relaxed">Elevate worship nights, baptisms, and outdoor services for churches in Phoenix, Tempe, Chandler, and throughout the Phoenix metro area with professional stages, clear audio, and readable LED screens designed for congregational engagement.</p>
          </div>

          <!-- Use Case 2 -->
          <div class="bg-brand-card border border-brand-border p-8 rounded-xl hover:border-brand-blue transition-colors group reveal" style="transition-delay: 100ms;">
            <div class="w-12 h-12 bg-brand-bg rounded-lg border border-brand-border flex items-center justify-center mb-6 group-hover:bg-brand-blue/10 transition-colors">
              <i class="ph ph-music-notes text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-white mb-3">Festivals & Concerts</h3>
            <p class="text-brand-muted text-sm leading-relaxed">Deliver high-impact live music experiences across Phoenix, Scottsdale, Mesa, and Arizona with band-ready stage setups, line-array sound systems, and dynamic stage lighting.</p>
          </div>

          <!-- Use Case 3 -->
          <div class="bg-brand-card border border-brand-border p-8 rounded-xl hover:border-brand-blue transition-colors group reveal" style="transition-delay: 200ms;">
            <div class="w-12 h-12 bg-brand-bg rounded-lg border border-brand-border flex items-center justify-center mb-6 group-hover:bg-brand-blue/10 transition-colors">
              <i class="ph ph-microphone-stage text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-white mb-3">Conferences & Speakers</h3>
            <p class="text-brand-muted text-sm leading-relaxed">Ensure crystal-clear communication for corporate events in Phoenix, Chandler, Gilbert, and the greater Arizona area with professional staging, podiums, specialized microphones, and large side screens for presentations.</p>
          </div>

          <!-- Use Case 4 -->
          <div class="bg-brand-card border border-brand-border p-8 rounded-xl hover:border-brand-blue transition-colors group reveal" style="transition-delay: 300ms;">
            <div class="w-12 h-12 bg-brand-bg rounded-lg border border-brand-border flex items-center justify-center mb-6 group-hover:bg-brand-blue/10 transition-colors">
              <i class="ph ph-users-three text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-white mb-3">Cities & Community Events</h3>
            <p class="text-brand-muted text-sm leading-relaxed">Create central gathering points for municipal events, holiday celebrations, and park gatherings across Phoenix, Mesa, Tempe, and throughout Arizona with robust, weather-ready staging.</p>
          </div>

          <!-- Use Case 5 -->
          <div class="bg-brand-card border border-brand-border p-8 rounded-xl hover:border-brand-blue transition-colors group reveal" style="transition-delay: 400ms;">
            <div class="w-12 h-12 bg-brand-bg rounded-lg border border-brand-border flex items-center justify-center mb-6 group-hover:bg-brand-blue/10 transition-colors">
              <i class="ph ph-graduation-cap text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-white mb-3">Schools & Nonprofits</h3>
            <p class="text-brand-muted text-sm leading-relaxed">Host graduation ceremonies, fundraisers, and outdoor movie nights for Arizona schools and nonprofits in Phoenix, Gilbert, Chandler, and surrounding areas with scalable packages that fit institutional budgets and requirements.</p>
          </div>

          <!-- Use Case 6 -->
          <div class="bg-brand-card border border-brand-border p-8 rounded-xl hover:border-brand-blue transition-colors group reveal" style="transition-delay: 500ms;">
            <div class="w-12 h-12 bg-brand-bg rounded-lg border border-brand-border flex items-center justify-center mb-6 group-hover:bg-brand-blue/10 transition-colors">
              <i class="ph ph-briefcase text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-white mb-3">AV & Production Companies</h3>
            <p class="text-brand-muted text-sm leading-relaxed">Scale your own event capabilities by subrenting our mobile stages, LED walls, or audio equipment for your client projects.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Value Proposition Section -->
    <section class="py-24 bg-white border-y border-gray-300">
      <div class="max-w-container mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <!-- Content -->
          <div class="order-2 lg:order-1 reveal">
            <h2 class="font-heading font-bold text-4xl uppercase text-brand-bg mb-6">One Provider. One Coordinated Setup.</h2>
            <p class="text-brand-dark text-lg mb-10 leading-relaxed">
              Instead of coordinating separate companies for the stage, sound, lighting, microphones, screens, and production support, AvValley can bring the major components of your outdoor event together under one rental plan.
            </p>

            <div class="space-y-8">
              <div class="flex gap-4">
                <div class="mt-1">
                  <i class="ph-fill ph-check-circle text-brand-blue text-2xl"></i>
                </div>
                <div>
                  <h4 class="font-heading font-bold text-brand-bg mb-1">Simplified Coordination</h4>
                  <p class="text-brand-dark text-sm">Work with one provider instead of managing several disconnected vendors.</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="mt-1">
                  <i class="ph-fill ph-check-circle text-brand-blue text-2xl"></i>
                </div>
                <div>
                  <h4 class="font-heading font-bold text-brand-bg mb-1">Flexible Packages</h4>
                  <p class="text-brand-dark text-sm">Rent the stage alone or build a complete event-production package.</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="mt-1">
                  <i class="ph-fill ph-check-circle text-brand-blue text-2xl"></i>
                </div>
                <div>
                  <h4 class="font-heading font-bold text-brand-bg mb-1">Professional Equipment</h4>
                  <p class="text-brand-dark text-sm">Use event-ready sound, lighting, screens, microphones, monitors, and staging equipment.</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="mt-1">
                  <i class="ph-fill ph-check-circle text-brand-blue text-2xl"></i>
                </div>
                <div>
                  <h4 class="font-heading font-bold text-brand-bg mb-1">Outdoor Event Experience</h4>
                  <p class="text-brand-dark text-sm">Choose a team focused specifically on outdoor stages and live-event logistics.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Image -->
          <div class="order-1 lg:order-2 relative rounded-2xl overflow-hidden border border-brand-border shadow-2xl reveal">
            <img src="https://avvalley.com/media/IMG_2218.jpg" alt="Concert Stage Setup Production" class="w-full h-auto object-cover aspect-square md:aspect-[4/5] object-center" />
            <div class="absolute inset-0 bg-brand-bg/30"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section class="py-24 bg-brand-grey">
      <div class="max-w-3xl mx-auto px-6 text-center reveal">
        <div class="bg-white border border-gray-300 rounded-2xl p-8 md:p-12 shadow-2xl relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-brand-blue to-transparent"></div>

