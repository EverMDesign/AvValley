---
import { MEDIA_URL } from '../lib/constants';
import BaseLayout from '../layouts/BaseLayout.astro';
import { MEDIA_URL } from '../lib/constants';
import ProjectionMappingForm from '../components/forms/ProjectionMappingForm.astro';
import { MEDIA_URL } from '../lib/constants';
import QuoteSection from '../components/QuoteSection.astro';
import { MEDIA_URL } from '../lib/constants';
import { getProjectionMappingSchema } from '../lib/schemas';

const mappingSchema = getProjectionMappingSchema();
---

<BaseLayout
  title="Projection Mapping Services in Arizona | AvValley"
  description="Create immersive event visuals with projection mapping for buildings, stages, walls, branded experiences, concerts, and installations. Request a consultation from AvValley."
  canonical="https://avvalley.com/projection-mapping/"
>
    </div>
  </header>

  <main class="flex-grow pt-20">
    <!-- Schema Markup -->
    <script type="application/ld+json" set:html={JSON.stringify(mappingSchema)} />

    <!-- Hero Section -->
    <section class="relative min-h-[60vh] flex items-center justify-center pt-12 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <img src={`${MEDIA_URL}/Avalley-projection-mapping-concert.webp`} alt="Cinematic architectural projection mapping display at night" class="w-full h-full object-cover object-center">
        <div class="absolute inset-0 bg-brand-bg/85"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-6 text-center my-12">
        <div class="animate-fade-in-up">
          <p class="text-brand-blue font-heading font-bold tracking-[0.2em] text-sm md:text-base mb-4">IMMERSIVE VISUAL EXPERIENCES</p>
          <h1 class="font-heading font-bold text-3xl md:text-4xl lg:text-5xl leading-[1.1] uppercase mb-6 text-white text-balance drop-shadow-lg">
            Projection Mapping<br/>For Events And<br/>Experiences
          </h1>
          <p class="text-brand-muted text-lg md:text-xl max-w-3xl mx-auto mb-10 text-balance leading-relaxed">
            Turn buildings, stages, walls, and custom surfaces into large-scale visual displays using precisely aligned projection, creative content, and event-production technology.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
            <a href="#quote" class="w-full sm:w-auto bg-brand-blue hover:bg-brand-hover text-white px-8 py-4 rounded font-heading font-bold uppercase tracking-wider transition-all shadow-[0_0_20px_rgba(22,154,220,0.4)] hover:shadow-[0_0_30px_rgba(26,175,232,0.6)] hover:-translate-y-1">
              Request A Mapping Consultation
            </a>
            <a href="#gallery" class="w-full sm:w-auto bg-transparent border-2 border-brand-blue text-white hover:bg-brand-blue/10 px-8 py-4 rounded font-heading font-bold uppercase tracking-wider transition-all hover:-translate-y-1">
              View Project Examples
            </a>
          </div>
          <p class="text-sm text-brand-muted flex items-center justify-center gap-2">
            <i class="ph-fill ph-info text-brand-blue"></i>
            Custom concepts, technical planning, content options, and live-event support available.
          </p>
        </div>
      </div>
    </section>

    <!-- Projection Mapping Intro Section -->
    <section class="py-24 bg-white border-y border-gray-300">
      <div class="max-w-container mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="relative rounded-2xl overflow-hidden border border-brand-border shadow-2xl reveal group">
            <img src={`${MEDIA_URL}/Avalley-projection-mapping-community.webp`} alt="Abstract colorful light projection on a textured surface" class="w-full h-auto object-cover aspect-[4/3] group-hover:scale-105 transition-transform duration-700">
            <div class="absolute inset-0 bg-brand-bg/30 mix-blend-multiply pointer-events-none"></div>
          </div>
          <div class="reveal" style="transition-delay: 200ms;">
            <p class="text-brand-blue font-heading font-bold tracking-[0.2em] text-sm mb-3">BEYOND A STANDARD SCREEN</p>
            <h2 class="font-heading font-bold text-4xl md:text-5xl uppercase text-brand-bg mb-6 leading-tight">Turn The Surface Into The Experience</h2>
            <p class="text-brand-dark text-lg mb-6 leading-relaxed">
              Projection mapping uses specialized software, calibrated projectors, and custom visual content to align imagery with the shape and dimensions of a physical surface. Instead of projecting onto a traditional rectangular screen, the visuals can follow architectural details, stage structures, branded installations, or other approved objects.
            </p>
            <p class="text-brand-dark text-lg mb-10 leading-relaxed">
              AvValley can help plan projection-mapping experiences for events, presentations, celebrations, installations, and branded environments.
            </p>
            <a href="#quote" class="inline-block bg-brand-blue hover:bg-brand-hover text-white px-8 py-3.5 rounded font-heading font-bold uppercase tracking-wider transition-colors shadow-[0_0_15px_rgba(22,154,220,0.3)] hover:shadow-[0_0_20px_rgba(26,175,232,0.5)]">
              Discuss Your Project
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="py-24 bg-brand-bg relative overflow-hidden">
      <div class="absolute top-1/2 left-0 -translate-y-1/2 w-[500px] h-[500px] bg-brand-blue/5 rounded-full blur-[120px] pointer-events-none"></div>
      <div class="max-w-container mx-auto px-6 relative z-10">
        <div class="text-center mb-16 reveal">
          <h2 class="font-heading font-bold text-4xl uppercase text-white mb-4">Create An Experience People Remember</h2>
          <div class="w-24 h-1 bg-brand-blue mx-auto rounded"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-brand-card border border-brand-border p-8 rounded-xl hover:border-brand-blue transition-colors group reveal relative overflow-hidden">
            <div class="absolute inset-0 bg-brand-blue/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="w-12 h-12 bg-brand-bg rounded-lg border border-brand-border flex items-center justify-center mb-6 group-hover:bg-brand-blue/20 transition-colors group-hover:shadow-[0_0_15px_rgba(22,154,220,0.4)] relative z-10">
              <i class="ph ph-buildings text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-white mb-3 relative z-10">Transform Physical Spaces</h3>
            <p class="text-brand-muted text-sm leading-relaxed relative z-10">Use architecture, stage structures, walls, or custom objects as part of the visual experience.</p>
          </div>

          <div class="bg-brand-card border border-brand-border p-8 rounded-xl hover:border-brand-blue transition-colors group reveal relative overflow-hidden" style="transition-delay: 100ms;">
            <div class="absolute inset-0 bg-brand-blue/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="w-12 h-12 bg-brand-bg rounded-lg border border-brand-border flex items-center justify-center mb-6 group-hover:bg-brand-blue/20 transition-colors group-hover:shadow-[0_0_15px_rgba(22,154,220,0.4)] relative z-10">
              <i class="ph ph-music-notes-simple text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-white mb-3 relative z-10">Support Event Storytelling</h3>
            <p class="text-brand-muted text-sm leading-relaxed relative z-10">Coordinate visuals with music, presentations, performances, branding, or event themes.</p>
          </div>

          <div class="bg-brand-card border border-brand-border p-8 rounded-xl hover:border-brand-blue transition-colors group reveal relative overflow-hidden" style="transition-delay: 200ms;">
            <div class="absolute inset-0 bg-brand-blue/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="w-12 h-12 bg-brand-bg rounded-lg border border-brand-border flex items-center justify-center mb-6 group-hover:bg-brand-blue/20 transition-colors group-hover:shadow-[0_0_15px_rgba(22,154,220,0.4)] relative z-10">
              <i class="ph ph-sparkle text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-white mb-3 relative z-10">Create Large-Scale Impact</h3>
            <p class="text-brand-muted text-sm leading-relaxed relative z-10">Produce visual moments that are more immersive than a standard projection screen.</p>
          </div>

          <div class="bg-brand-card border border-brand-border p-8 rounded-xl hover:border-brand-blue transition-colors group reveal relative overflow-hidden" style="transition-delay: 300ms;">
            <div class="absolute inset-0 bg-brand-blue/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <div class="w-12 h-12 bg-brand-bg rounded-lg border border-brand-border flex items-center justify-center mb-6 group-hover:bg-brand-blue/20 transition-colors group-hover:shadow-[0_0_15px_rgba(22,154,220,0.4)] relative z-10">
              <i class="ph ph-sliders text-2xl text-brand-blue"></i>
            </div>
            <h3 class="font-heading font-bold text-xl text-white mb-3 relative z-10">Customize the Experience</h3>
            <p class="text-brand-muted text-sm leading-relaxed relative z-10">Develop visuals around the surface, event identity, audience, and production goals.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Projection Surfaces Section -->
    <section class="py-24 bg-brand-grey border-y border-gray-300">
      <div class="max-w-container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16 reveal">
          <h2 class="font-heading font-bold text-4xl uppercase text-brand-bg mb-4">Potential Projection Surfaces</h2>
          <p class="text-brand-dark text-lg">
            Projection-mapping feasibility depends on surface shape, color, distance, ambient light, viewing angle, installation access, and the available projection equipment.
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-12">
          <div class="bg-white border border-gray-300 p-6 rounded-lg text-center hover:border-brand-blue transition-colors reveal group">
            <i class="ph-light ph-buildings text-3xl text-brand-blue mb-3 group-hover:scale-110 transition-transform"></i>
            <p class="text-sm font-semibold text-brand-bg">Building facades</p>
          </div>
          <div class="bg-white border border-gray-300 p-6 rounded-lg text-center hover:border-brand-blue transition-colors reveal group" style="transition-delay: 50ms;">
            <i class="ph-light ph-wall text-3xl text-brand-blue mb-3 group-hover:scale-110 transition-transform"></i>
            <p class="text-sm font-semibold text-brand-bg">Interior walls</p>
          </div>
          <div class="bg-white border border-gray-300 p-6 rounded-lg text-center hover:border-brand-blue transition-colors reveal group" style="transition-delay: 100ms;">
            <i class="ph-light ph-presentation-chart text-3xl text-brand-blue mb-3 group-hover:scale-110 transition-transform"></i>
            <p class="text-sm font-semibold text-brand-bg">Stage backdrops</p>
          </div>
          <div class="bg-white border border-gray-300 p-6 rounded-lg text-center hover:border-brand-blue transition-colors reveal group" style="transition-delay: 150ms;">
            <i class="ph-light ph-storefront text-3xl text-brand-blue mb-3 group-hover:scale-110 transition-transform"></i>
            <p class="text-sm font-semibold text-brand-bg">Venue exteriors</p>
          </div>
          <div class="bg-white border border-gray-300 p-6 rounded-lg text-center hover:border-brand-blue transition-colors reveal group" style="transition-delay: 200ms;">
            <i class="ph-light ph-briefcase text-3xl text-brand-blue mb-3 group-hover:scale-110 transition-transform"></i>
            <p class="text-sm font-semibold text-brand-bg">Corporate spaces</p>
          </div>
          <div class="bg-white border border-gray-300 p-6 rounded-lg text-center hover:border-brand-blue transition-colors reveal group" style="transition-delay: 250ms;">
            <i class="ph-light ph-palette text-3xl text-brand-blue mb-3 group-hover:scale-110 transition-transform"></i>
            <p class="text-sm font-semibold text-brand-bg">Art installations</p>
          </div>
          <div class="bg-white border border-gray-300 p-6 rounded-lg text-center hover:border-brand-blue transition-colors reveal group" style="transition-delay: 300ms;">
            <i class="ph-light ph-package text-3xl text-brand-blue mb-3 group-hover:scale-110 transition-transform"></i>
            <p class="text-sm font-semibold text-brand-bg">Product displays</p>
          </div>
          <div class="bg-white border border-gray-300 p-6 rounded-lg text-center hover:border-brand-blue transition-colors reveal group" style="transition-delay: 350ms;">
            <i class="ph-light ph-cube text-3xl text-brand-blue mb-3 group-hover:scale-110 transition-transform"></i>
            <p class="text-sm font-semibold text-brand-bg">Custom objects</p>
          </div>
          <div class="bg-white border border-gray-300 p-6 rounded-lg text-center hover:border-brand-blue transition-colors reveal group" style="transition-delay: 400ms;">
            <i class="ph-light ph-tree-structure text-3xl text-brand-blue mb-3 group-hover:scale-110 transition-transform"></i>
            <p class="text-sm font-semibold text-brand-bg">Scenic structures</p>
          </div>
          <div class="bg-white border border-gray-300 p-6 rounded-lg text-center hover:border-brand-blue transition-colors reveal group" style="transition-delay: 450ms;">
            <i class="ph-light ph-tent text-3xl text-brand-blue mb-3 group-hover:scale-110 transition-transform"></i>
            <p class="text-sm font-semibold text-brand-bg">Temporary event installations</p>
          </div>
        </div>

        <div class="bg-white border border-gray-300 rounded-lg p-6 flex flex-col md:flex-row items-center justify-center gap-4 reveal text-center md:text-left">
          <div class="shrink-0 w-12 h-12 bg-brand-grey rounded-full flex items-center justify-center border border-gray-300">
            <i class="ph-fill ph-warning-circle text-brand-blue text-2xl"></i>
          </div>
          <p class="text-brand-dark text-sm font-medium">
            <strong class="text-brand-bg">Important Note:</strong> Every location and surface must be evaluated before the project is confirmed. We cannot guarantee projection mapping feasibility without reviewing site conditions.
          </p>
        </div>
      </div>
    </section>

    <!-- Use Cases Section -->
    <section class="py-24 bg-brand-bg relative overflow-hidden">
      <div class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-brand-blue/5 rounded-full blur-[150px] pointer-events-none"></div>
      <div class="max-w-container mx-auto px-6 relative z-10">
        <div class="text-center mb-16 reveal">
          <h2 class="font-heading font-bold text-4xl uppercase text-white mb-4">Projection Mapping for Events, Brands, and Installations</h2>
          <div class="w-24 h-1 bg-brand-blue mx-auto rounded"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="relative h-[250px] rounded-xl overflow-hidden group border border-brand-border reveal card-gradient cursor-pointer">
            <img src={`${MEDIA_URL}/Avalley-projection-mapping-public.webp`} alt="Festivals" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-5">
              <h3 class="font-heading font-bold text-lg text-white mb-1 group-hover:text-brand-blue transition-colors leading-tight">Festivals and Public Events</h3>
              <p class="text-brand-muted text-xs mb-3 line-clamp-2">Engage large crowds with mapped main stages or interactive art zones.</p>
              <a href="#quote" class="inline-flex items-center gap-1 text-brand-blue font-bold uppercase text-[10px] tracking-wider hover:text-brand-hover transition-colors">
                Discuss This Project <i class="ph-bold ph-arrow-right"></i>
              </a>
            </div>
          </div>

          <div class="relative h-[250px] rounded-xl overflow-hidden group border border-brand-border reveal card-gradient cursor-pointer" style="transition-delay: 50ms;">
            <img src={`${MEDIA_URL}/Avalley-projection-mapping-corporate.webp`} alt="Corporate" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-5">
              <h3 class="font-heading font-bold text-lg text-white mb-1 group-hover:text-brand-blue transition-colors leading-tight">Corporate Events</h3>
              <p class="text-brand-muted text-xs mb-3 line-clamp-2">Elevate galas and awards nights with immersive venue transformations.</p>
              <a href="#quote" class="inline-flex items-center gap-1 text-brand-blue font-bold uppercase text-[10px] tracking-wider hover:text-brand-hover transition-colors">
                Discuss This Project <i class="ph-bold ph-arrow-right"></i>
              </a>
            </div>
          </div>

          <div class="relative h-[250px] rounded-xl overflow-hidden group border border-brand-border reveal card-gradient cursor-pointer" style="transition-delay: 100ms;">
            <img src={`${MEDIA_URL}/Avalley-projection-mapping-concert.webp`} alt="Concerts" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-5">
              <h3 class="font-heading font-bold text-lg text-white mb-1 group-hover:text-brand-blue transition-colors leading-tight">Concerts and Live Performances</h3>
              <p class="text-brand-muted text-xs mb-3 line-clamp-2">Sync complex visuals to live music and stage movements.</p>
              <a href="#quote" class="inline-flex items-center gap-1 text-brand-blue font-bold uppercase text-[10px] tracking-wider hover:text-brand-hover transition-colors">
                Discuss This Project <i class="ph-bold ph-arrow-right"></i>
              </a>
            </div>
          </div>

          <div class="relative h-[250px] rounded-xl overflow-hidden group border border-brand-border reveal card-gradient cursor-pointer" style="transition-delay: 150ms;">
            <img src={`${MEDIA_URL}/Avalley-projection-mapping-wedding.webp`} alt="Weddings" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-5">
              <h3 class="font-heading font-bold text-lg text-white mb-1 group-hover:text-brand-blue transition-colors leading-tight">Weddings and Celebrations</h3>
              <p class="text-brand-muted text-xs mb-3 line-clamp-2">Personalize venues with mapped monograms, scenery, or cake projections.</p>
              <a href="#quote" class="inline-flex items-center gap-1 text-brand-blue font-bold uppercase text-[10px] tracking-wider hover:text-brand-hover transition-colors">
                Discuss This Project <i class="ph-bold ph-arrow-right"></i>
              </a>
            </div>
          </div>

          <div class="relative h-[250px] rounded-xl overflow-hidden group border border-brand-border reveal card-gradient cursor-pointer" style="transition-delay: 200ms;">
            <img src={`${MEDIA_URL}/Avalley-projection-mapping-church.webp`} alt="Churches" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-5">
              <h3 class="font-heading font-bold text-lg text-white mb-1 group-hover:text-brand-blue transition-colors leading-tight">Churches and Worship Events</h3>
              <p class="text-brand-muted text-xs mb-3 line-clamp-2">Enhance sanctuary architecture or stage design for special services.</p>
              <a href="#quote" class="inline-flex items-center gap-1 text-brand-blue font-bold uppercase text-[10px] tracking-wider hover:text-brand-hover transition-colors">
                Discuss This Project <i class="ph-bold ph-arrow-right"></i>
              </a>
            </div>
          </div>

          <div class="relative h-[250px] rounded-xl overflow-hidden group border border-brand-border reveal card-gradient cursor-pointer" style="transition-delay: 250ms;">
            <img src={`${MEDIA_URL}/Avalley-projection-mapping-community.webp`} alt="Community Events" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 z-20 flex flex-col justify-end p-5">
              <h3 class="font-heading font-bold text-lg text-white mb-1 group-hover:text-brand-blue transition-colors leading-tight">Community and Municipal Events</h3>
              <p class="text-brand-muted text-xs mb-3 line-clamp-2">Map historical buildings or city landmarks for holiday celebrations.</p>
              <a href="#quote" class="inline-flex items-center gap-1 text-brand-blue font-bold uppercase text-[10px] tracking-wider hover:text-brand-hover transition-colors">
                Discuss This Project <i class="ph-bold ph-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="py-24 bg-brand-grey border-t border-gray-300">
      <div class="max-w-container mx-auto px-6">
        <div class="text-center mb-16 reveal">
          <h2 class="font-heading font-bold text-4xl uppercase text-brand-bg">How Projection Mapping Works</h2>
        </div>

        <div class="relative reveal">
          <div class="hidden lg:block absolute top-12 left-0 w-full h-px bg-brand-border z-0"></div>

          <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 relative z-10">
            <div class="relative p-6 bg-white/80 backdrop-blur lg:bg-transparent lg:backdrop-blur-none lg:p-0">
              <div class="w-24 h-24 rounded-full bg-brand-grey border border-gray-300 flex items-center justify-center text-3xl font-heading font-bold text-brand-blue shadow-[0_0_15px_rgba(22,154,220,0.2)] mb-6 mx-auto lg:mx-0">
                01
              </div>
              <h3 class="font-heading font-bold text-xl text-brand-bg mb-3 text-center lg:text-left">Consultation and Project Discovery</h3>
              <p class="text-brand-dark text-sm leading-relaxed text-center lg:text-left">Review the event, location, surface, audience, schedule, visual goals, and available production resources.</p>
            </div>

            <div class="relative p-6 bg-white/80 backdrop-blur lg:bg-transparent lg:backdrop-blur-none lg:p-0" style="transition-delay: 100ms;">
              <div class="w-24 h-24 rounded-full bg-brand-grey border border-gray-300 flex items-center justify-center text-3xl font-heading font-bold text-brand-blue shadow-[0_0_15px_rgba(22,154,220,0.2)] mb-6 mx-auto lg:mx-0">
                02
              </div>
              <h3 class="font-heading font-bold text-xl text-brand-bg mb-3 text-center lg:text-left">Site and Technical Evaluation</h3>
              <p class="text-brand-dark text-sm leading-relaxed text-center lg:text-left">Evaluate the surface dimensions, projector placement, ambient lighting, power, access, throw distance, sightlines, and installation requirements.</p>
            </div>

            <div class="relative p-6 bg-white/80 backdrop-blur lg:bg-transparent lg:backdrop-blur-none lg:p-0" style="transition-delay: 200ms;">
              <div class="w-24 h-24 rounded-full bg-brand-grey border border-gray-300 flex items-center justify-center text-3xl font-heading font-bold text-brand-blue shadow-[0_0_15px_rgba(22,154,220,0.2)] mb-6 mx-auto lg:mx-0">
                03
              </div>
              <h3 class="font-heading font-bold text-xl text-brand-bg mb-3 text-center lg:text-left">Content and Mapping Development</h3>
              <p class="text-brand-dark text-sm leading-relaxed text-center lg:text-left">Prepare the mapping layout and determine whether the project will use customer-supplied content, adapted content, or custom-created visuals.</p>
            </div>

            <div class="relative p-6 bg-white/80 backdrop-blur lg:bg-transparent lg:backdrop-blur-none lg:p-0" style="transition-delay: 300ms;">
              <div class="w-24 h-24 rounded-full bg-brand-blue border border-brand-blue flex items-center justify-center text-3xl font-heading font-bold text-white shadow-[0_0_20px_rgba(22,154,220,0.4)] mb-6 mx-auto lg:mx-0">
                04
              </div>
              <h3 class="font-heading font-bold text-xl text-brand-bg mb-3 text-center lg:text-left">Installation and Show Operation</h3>
              <p class="text-brand-dark text-sm leading-relaxed text-center lg:text-left">Install and calibrate the projection system, test the mapped content, and provide available live-show or playback support.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Requirements Section -->
    <section class="py-24 bg-brand-bg border-t border-brand-border relative overflow-hidden">
      <div class="max-w-5xl mx-auto px-6 reveal">
        <div class="bg-brand-card border border-brand-border rounded-2xl p-10 shadow-2xl">
          <h2 class="font-heading font-bold text-3xl md:text-4xl uppercase text-white mb-6 text-center">What We Need To Evaluate Your Project</h2>
          <p class="text-brand-muted text-center mb-10">The more accurate the project information, the more precise the production plan and quote can be.</p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-4">
            <ul class="space-y-4">
